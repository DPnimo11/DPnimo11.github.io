---
import ProjectVisual from "./ProjectVisual.astro";
import type { Project } from "../data/projects";

interface Props {
  project: Project;
  compact?: boolean;
}

const { project, compact = false } = Astro.props;
---

<article class:list={["project-card", compact && "compact"]}>
  <a href={`/projects/${project.slug}/`} aria-label={`Read ${project.title} case study`}>
    <ProjectVisual variant={project.visual} image={project.image} title={project.title} />
    <div class="project-card-body">
      <div class="project-meta">
        <span>{project.kicker}</span>
        <span>{project.year}</span>
      </div>
      <h3>{project.title}</h3>
      <p>{project.summary}</p>
      <div class="tag-row" aria-label={`${project.title} technologies`}>
        {project.stack.slice(0, compact ? 3 : 5).map((tag) => <span>{tag}</span>)}
      </div>
    </div>
  </a>
</article>

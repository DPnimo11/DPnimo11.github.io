---
import HeroArtifactStack from "../components/HeroArtifactStack.astro";
import ProjectCard from "../components/ProjectCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/projects";

const featuredSlugs = [
  "pepdock",
  "pennos",
  "cis5810-collision-demo",
  "nexhacks-swipehire",
];

const featured = featuredSlugs.map((slug) => {
  const project = projects.find((item) => item.slug === slug);
  if (!project) throw new Error(`Missing featured project: ${slug}`);
  return project;
});
---

<BaseLayout
  title="Darren Wang | Penn CS & Robotics Portfolio"
  description="Darren Wang is a University of Pennsylvania computer science and robotics student building computational biology research software, ML/data pipelines, systems projects, and full-stack apps."
>
  <section class="hero-section">
    <div class="hero-copy">
      <p class="eyebrow">Penn CIS + Robotics</p>
      <h1>Darren Wang</h1>
      <p class="hero-lede">
        I study computer science at Penn and am pursuing an accelerated master's in robotics. This site holds some of my work: computational biology research, ML/data projects, systems code, and a few web apps.
      </p>
      <div class="action-row">
        <a class="button primary" href="/projects/">View projects</a>
        <a class="button mobile-secondary-action" href="/about/">About</a>
        <a class="button mobile-secondary-action" href="/resume">Resume</a>
        <a class="button" href="#contact">Contact</a>
      </div>
    </div>
    <aside class="hero-artifact" aria-label="Layered technical artifact stack">
      <HeroArtifactStack />
    </aside>
  </section>

  <section class="at-a-glance" aria-label="Penn context">
    <h2>At Penn</h2>
    <ul>
      <li>
        <span>CSS / PURM</span>
        <p>Spending the summer working with Prof. Duncan Watts through PURM at CSS.</p>
      </li>
      <li>
        <span>Teaching</span>
        <p>Joining CIS 4500/3200 as a TA this fall.</p>
      </li>
      <li>
        <span>Communities</span>
        <p>Part of Penn Spark, Penn Aerospace Club, and STWing.</p>
      </li>
    </ul>
  </section>

  <section class="section-heading">
    <p class="eyebrow">Selected work</p>
    <h2>Projects worth opening.</h2>
    <a href="/projects/">All projects</a>
  </section>

  <section class="project-grid">
    {featured.map((project) => <ProjectCard project={project} />)}
  </section>
</BaseLayout>

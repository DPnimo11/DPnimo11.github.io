---
// src/components/HelixBackground.astro
---
<div id="helix-container" aria-hidden="true"></div>

<script>
  import * as THREE from 'three';

  const container = document.getElementById('helix-container');
  if (container) {
    const scene = new THREE.Scene();
    
    const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 1000);
    // Position camera so helix goes bottom-left to top-right
    camera.position.z = 40;
    
    const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    container.appendChild(renderer.domElement);

    const tiltGroup = new THREE.Group();
    const helixGroup = new THREE.Group();
    tiltGroup.add(helixGroup);
    
    // Math for the helix
    const numPoints = 800;
    const height = 60;
    const radius = 7.5; // Increased for thickness
    const frequency = 0.3; // How tightly wound it is

    // --- Strand 1: Wireframe Tube (Biology) ---
    const points1 = [];
    for (let i = 0; i < numPoints; i++) {
      const t = i / numPoints;
      const y = (t - 0.5) * height;
      const angle = t * height * frequency;
      const x = Math.cos(angle) * radius;
      const z = Math.sin(angle) * radius;
      points1.push(new THREE.Vector3(x, y, z));
    }
    const curve1 = new THREE.CatmullRomCurve3(points1);
    // Increased tube radius to 0.75 for much more thickness
    const geometry1 = new THREE.TubeGeometry(curve1, 150, 0.75, 6, false);
    const wireframeGeo = new THREE.WireframeGeometry(geometry1);
    const lineMat = new THREE.LineBasicMaterial({ color: 0x111613, transparent: true, opacity: 0.35, linewidth: 1 });
    const wireframeTube = new THREE.LineSegments(wireframeGeo, lineMat);
    helixGroup.add(wireframeTube);

    // --- Strand 2: Code Stream (CS) ---
    const points2 = [];
    for (let i = 0; i < numPoints; i++) {
      const t = i / numPoints;
      const y = (t - 0.5) * height;
      const angle = t * height * frequency + Math.PI; // Opposite phase
      const x = Math.cos(angle) * radius;
      const z = Math.sin(angle) * radius;
      points2.push(new THREE.Vector3(x, y, z));
    }
    const curve2 = new THREE.CatmullRomCurve3(points2);

    const codeLines = [
      "struct pcb_t {",
      "  pid_t pid;",
      "  int status;",
      "  void *stack;",
      "  struct pcb_t *next;",
      "};",
      "void schedule() {",
      "  pcb_t *p = pop();",
      "  context_switch(p);",
      "}",
      "import torch",
      "import torch.nn as nn",
      "class Model(nn.Module):",
      "  def forward(self, x):",
      "    return self.fc(x)"
    ];
    
    const createTextPlane = (text) => {
      const canvas = document.createElement('canvas');
      canvas.width = 512;
      canvas.height = 64;
      const ctx = canvas.getContext('2d');
      if (ctx) {
        ctx.fillStyle = 'rgba(255, 255, 255, 0)';
        ctx.fillRect(0, 0, 512, 64);
        ctx.fillStyle = '#111613';
        ctx.font = 'bold 36px monospace';
        ctx.textAlign = 'left';
        ctx.textBaseline = 'middle';
        ctx.fillText(text, 10, 32);
      }
      
      const texture = new THREE.CanvasTexture(canvas);
      // Improve texture filtering for text
      texture.minFilter = THREE.LinearFilter;
      
      const material = new THREE.MeshBasicMaterial({
        map: texture,
        transparent: true,
        opacity: 0.85,
        depthWrite: false,
        side: THREE.DoubleSide
      });
      const geometry = new THREE.PlaneGeometry(4.0, 0.5);
      return new THREE.Mesh(geometry, material);
    };

    // Dramatically increased density
    const numPlanes = 250; 
    for(let i = 0; i < numPlanes; i++) {
      const t = i / (numPlanes - 1);
      const pt = curve2.getPoint(t);
      const tangent = curve2.getTangent(t).normalize();
      
      const textIndex = i % codeLines.length;
      const mesh = createTextPlane(codeLines[textIndex]);
      mesh.position.copy(pt);
      
      // Orient the mesh to flow ALONG the curve
      // X axis aligns with the tangent vector
      // Z axis points outward from the center
      const outward = new THREE.Vector3(pt.x, 0, pt.z).normalize();
      const up = new THREE.Vector3().crossVectors(tangent, outward).normalize();
      
      const matrix = new THREE.Matrix4();
      matrix.makeBasis(tangent, up, outward);
      mesh.quaternion.setFromRotationMatrix(matrix);
      
      helixGroup.add(mesh);
    }

    // --- Connecting Rungs (Half Bio, Half Code) ---
    for (let i = 0; i < numPoints; i += 20) {
      const t = i / numPoints;
      const y = (t - 0.5) * height;
      
      const angle1 = t * height * frequency;
      const x1 = Math.cos(angle1) * radius;
      const z1 = Math.sin(angle1) * radius;
      
      const angle2 = t * height * frequency + Math.PI;
      const x2 = Math.cos(angle2) * radius;
      const z2 = Math.sin(angle2) * radius;
      
      const p1 = new THREE.Vector3(x1, y, z1); // Bio strand
      const p2 = new THREE.Vector3(x2, y, z2); // Code strand
      const distance = p1.distanceTo(p2);
      const midPoint = p1.clone().lerp(p2, 0.5);
      
      // Bio Half (Wireframe Cylinder)
      const bioGeo = new THREE.CylinderGeometry(0.15, 0.15, distance / 2, 5);
      const bioWireframeGeo = new THREE.WireframeGeometry(bioGeo);
      const bioMat = new THREE.LineBasicMaterial({ color: 0x111613, transparent: true, opacity: 0.35 });
      const bioMesh = new THREE.LineSegments(bioWireframeGeo, bioMat);
      
      bioMesh.position.copy(p1.clone().lerp(midPoint, 0.5));
      bioMesh.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), midPoint.clone().sub(p1).normalize());
      helixGroup.add(bioMesh);

      // Code Half (Text Plane oriented along the rung)
      const textIndex = (i / 20) % codeLines.length;
      const codeMesh = createTextPlane(codeLines[textIndex]);
      
      // Scale down to fit the rung length (roughly 4.0 plane width vs distance/2 ~ 7.5)
      codeMesh.scale.set(0.6, 0.6, 0.6); 
      codeMesh.position.copy(midPoint.clone().lerp(p2, 0.5));
      
      const rungVector = p2.clone().sub(midPoint).normalize();
      const outward = new THREE.Vector3(codeMesh.position.x, 0, codeMesh.position.z).normalize();
      const up = new THREE.Vector3().crossVectors(rungVector, outward).normalize();
      
      const matrix = new THREE.Matrix4();
      matrix.makeBasis(rungVector, up, outward);
      codeMesh.quaternion.setFromRotationMatrix(matrix);
      
      helixGroup.add(codeMesh);
    }

    // Position and tilt the parent group (Moved significantly Left)
    tiltGroup.rotation.z = -Math.PI / 4; 
    tiltGroup.position.x = -12; // Moved left
    tiltGroup.position.y = -5;
    
    scene.add(tiltGroup);

    // Animation Loop
    const animate = function () {
      requestAnimationFrame(animate);
      
      // Pure rotation around the internal Y axis
      helixGroup.rotation.y += 0.0025;
      
      renderer.render(scene, camera);
    };

    animate();

    // Handle Window Resize
    window.addEventListener('resize', () => {
      const parent = container.parentElement;
      if (parent) {
        camera.aspect = parent.clientWidth / parent.clientHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(parent.clientWidth, parent.clientHeight);
      }
    });
    
    // Initial size
    const parent = container.parentElement;
    if (parent) {
      camera.aspect = parent.clientWidth / parent.clientHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(parent.clientWidth, parent.clientHeight);
    }
  }
</script>

<style>
  #helix-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }
</style>

---
// src/components/HeroArtifactStack.astro
const terminalLines = [
  [
    { text: "$", tone: "prompt" },
    { text: " ls -al", tone: "command" },
  ],
  [
    { text: "drwxr-xr-x  ", tone: "muted" },
    { text: "trajectories/", tone: "path" },
  ],
  [
    { text: "-rw-r--r--  ", tone: "muted" },
    { text: "stops.parquet", tone: "path" },
  ],
  [
    { text: "-rw-r--r--  ", tone: "muted" },
    { text: "gyration.py", tone: "path" },
  ],
  [
    { text: "$", tone: "prompt" },
    { text: " python detect_stops.py --eps 50 --min-pts 4", tone: "command" },
  ],
  [
    { text: "[12:53]", tone: "meta" },
    { text: " loading 1.2M pings ..." },
  ],
  [
    { text: "[12:57]", tone: "meta" },
    { text: " clustering ... done" },
  ],
  [
    { text: "$", tone: "prompt" },
    { text: " lomonosov probe --dtm", tone: "command" },
  ],
  [{ text: "position: KQPKRBN" }],
  [{ text: "dtm: 549" }],
  [{ text: "best: Kf5" }],
  [
    { text: "$", tone: "prompt" },
    { text: ' cowsay "still running"', tone: "command" },
  ],
  [{ text: " _______________" }],
  [{ text: "< still running >" }],
  [{ text: " ---------------" }],
  [{ text: "        \\   ^__^" }],
  [{ text: "         \\  (oo)\\_______" }],
  [{ text: "            (__)\\       )\\/\\" }],
  [{ text: "                ||----w |" }],
  [{ text: "                ||     ||" }],
  [
    { text: "$", tone: "prompt" },
    { text: " " },
  ],
];

const chessPieces = [
  // Higher depth values render in front of lower ones. These values only
  // control piece-to-piece overlap; --chess-z controls the whole panel.
  {
    className: "black-knight",
    square: "b8",
    src: "/img/home-artifacts/chess-black-knight.png",
    width: 320,
    height: 450,
    x: 20.351,
    y: 39.008,
    pieceWidth: 6.4,
    anchorX: -44.2,
    basePad: 8.4,
    depth: 2,
  },
  {
    className: "black-king",
    square: "d8",
    src: "/img/home-artifacts/chess-black-king.png",
    width: 280,
    height: 490,
    x: 29.429,
    y: 35.865,
    pieceWidth: 5.9,
    anchorX: -44.3,
    basePad: 5.7,
    depth: 2,
  },
  {
    className: "white-queen",
    square: "g7",
    src: "/img/home-artifacts/chess-white-queen.png",
    width: 260,
    height: 490,
    x: 46.057,
    y: 35.215,
    pieceWidth: 5.4,
    anchorX: -46.5,
    basePad: 5.3,
    depth: 3,
  },
  {
    className: "white-pawn",
    square: "g6",
    src: "/img/home-artifacts/chess-white-pawn.png",
    width: 250,
    height: 370,
    x: 49.068,
    y: 39.281,
    pieceWidth: 6.1,
    anchorX: -37,
    basePad: 7,
    depth: 4,
  },
  {
    className: "white-king",
    square: "f6",
    src: "/img/home-artifacts/chess-white-king.png",
    width: 290,
    height: 510,
    x: 44.529,
    y: 40.853,
    pieceWidth: 5.5,
    anchorX: -50.2,
    basePad: 3.7,
    depth: 5,
  },
  {
    className: "black-bishop",
    square: "h4",
    src: "/img/home-artifacts/chess-black-bishop.png",
    width: 230,
    height: 470,
    x: 59.628,
    y: 45.84,
    pieceWidth: 5.3,
    anchorX: -40,
    basePad: 8.7,
    depth: 6,
  },
  {
    className: "black-rook",
    square: "b3",
    src: "/img/home-artifacts/chess-black-rook.png",
    width: 300,
    height: 440,
    x: 35.403,
    y: 59.338,
    pieceWidth: 6.2,
    anchorX: -39,
    basePad: 9.1,
    depth: 7,
  },
];

const chessPieceStyle = (piece) =>
  `--piece-x: ${piece.x}%; --piece-y: ${piece.y}%; --piece-width: ${piece.pieceWidth}%; --piece-anchor-x: ${piece.anchorX}%; --piece-base-pad: ${piece.basePad}%; --piece-depth: ${piece.depth};`;
---

<div class="artifact-stack" aria-hidden="true">
  <section class="artifact-panel terminal-panel">
    <span class="panel-shadow"></span>
    <img
      class="panel-base"
      src="/img/home-artifacts/terminal-panel.png"
      width="1080"
      height="720"
      alt=""
      loading="eager"
      decoding="async"
      fetchpriority="high"
      draggable="false"
    />
    <span class="terminal-light terminal-light-red"></span>
    <span class="terminal-light terminal-light-yellow"></span>
    <span class="terminal-light terminal-light-green"></span>
    <pre class="terminal-copy"><code>{terminalLines.flatMap((line, lineIndex) => [
      ...line.map((token) => (
        <span class={`terminal-token token-${"tone" in token ? token.tone : "output"}`}>{token.text}</span>
      )),
      lineIndex < terminalLines.length - 1 ? "\n" : "",
    ])}<span class="terminal-cursor"></span></code></pre>
  </section>

  <section class="artifact-panel protein-panel">
    <span class="panel-shadow"></span>
    <img
      class="panel-base"
      src="/img/home-artifacts/protein-panel.png"
      width="1080"
      height="720"
      alt=""
      loading="eager"
      decoding="async"
      draggable="false"
    />
  </section>

  <section class="artifact-panel map-panel">
    <span class="panel-shadow"></span>
    <img
      class="panel-base"
      src="/img/home-artifacts/map-panel.png"
      width="1080"
      height="720"
      alt=""
      loading="eager"
      decoding="async"
      draggable="false"
    />
    <span class="map-marker-cover map-marker-cover-blue"></span>
    <span class="map-marker-cover map-marker-cover-amber"></span>
    <span class="map-ripple map-ripple-blue"></span>
    <span class="map-ripple map-ripple-amber"></span>
    <span class="map-home-marker map-home-marker-blue"></span>
    <span class="map-home-marker map-home-marker-amber"></span>
  </section>

  <section class="artifact-panel data-panel">
    <span class="panel-shadow"></span>
    <img
      class="panel-base"
      src="/img/home-artifacts/data-panel.png"
      width="1080"
      height="720"
      alt=""
      loading="eager"
      decoding="async"
      draggable="false"
    />
  </section>

  <section class="artifact-panel chess-panel">
    <span class="panel-shadow"></span>
    <img
      class="panel-base"
      src="/img/home-artifacts/chess-board.png"
      width="1080"
      height="720"
      alt=""
      loading="eager"
      decoding="async"
      draggable="false"
    />
    <span class="chess-position chess-contact-layer">
      {
        chessPieces.map((piece) => (
          <span
            class={`chess-piece piece-${piece.className}`}
            data-square={piece.square}
            style={chessPieceStyle(piece)}
          >
            <span class="piece-shadow"></span>
          </span>
        ))
      }
    </span>
  </section>

  <span class="chess-position chess-piece-layer">
    {
      chessPieces.map((piece) => (
        <span
          class={`chess-piece piece-${piece.className}`}
          data-square={piece.square}
          style={chessPieceStyle(piece)}
        >
          <img
            src={piece.src}
            width={piece.width}
            height={piece.height}
            alt=""
            loading="eager"
            decoding="async"
            draggable="false"
          />
        </span>
      ))
    }
  </span>
</div>

<style>
  .artifact-stack {
    /*
     * QUICK TUNING CONTROLS
     * x/y move a panel, w changes its size, and z changes overlap order.
     * Percentages are relative to the full artifact viewport.
     */
    --terminal-x: 5%;
    --terminal-y: 9%;
    --terminal-w: 55%;
    --terminal-z: 1;

    --protein-x: 30%;
    --protein-y: 27%;
    --protein-w: 50%;
    --protein-z: 5;

    --map-x: 7%;
    --map-y: 40%;
    --map-w: 50%;
    --map-z: 4;

    --data-x: 38%;
    --data-y: 47%;
    --data-w: 50%;
    --data-z: 3;

    --chess-x: 18%;
    --chess-y: 60%;
    --chess-w: 50%;
    --chess-z: 2;
    --chess-pieces-z: 6;

    /* Any CSS color works here: #315e72, #c89b4a, rgb(...), etc. */
    --terminal-text-color: #2b3038;
    --terminal-command-color: #252b31;
    --terminal-path-color: #315e72;
    --terminal-meta-color: #59656a;
    --terminal-muted-color: #5d686c;
    --terminal-prompt-color: #2e7d56;
    --terminal-text-opacity: 0.82;
    --artifact-stage-w: min(112%, 680px);

    /* Pointer travel is measured in pixels at the front of the stack. */
    --artifact-parallax-x: 15px;
    --artifact-parallax-y: 15px;
    /* Radius is a fraction of each panel's shorter side. */
    --artifact-parallax-radius: 0.68;

    --pointer-terminal-x: 0px;
    --pointer-terminal-y: 0px;
    --pointer-protein-x: 0px;
    --pointer-protein-y: 0px;
    --pointer-map-x: 0px;
    --pointer-map-y: 0px;
    --pointer-data-x: 0px;
    --pointer-data-y: 0px;
    --pointer-chess-x: 0px;
    --pointer-chess-y: 0px;

    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    width: var(--artifact-stage-w);
    aspect-ratio: 1.16 / 1;
    container-type: inline-size;
    overflow: visible;
    pointer-events: none;
    transform: translate(-50%, -50%);
  }

  .artifact-panel {
    --panel-x: 0%;
    --panel-y: 0%;
    --panel-w: 50%;
    --panel-z: 1;
    --panel-mask: none;
    --pointer-panel-x: 0px;
    --pointer-panel-y: 0px;
    --float-from-x: 0px;
    --float-from-y: 0px;
    --float-from-rotate: 0deg;
    --float-to-x: 0px;
    --float-to-y: -2px;
    --float-to-rotate: 0deg;
    --float-duration: 10s;
    --float-delay: 0s;
    position: absolute;
    top: var(--panel-y);
    left: var(--panel-x);
    z-index: var(--panel-z);
    width: var(--panel-w);
    aspect-ratio: 3 / 2;
    background: transparent;
    color: inherit;
    isolation: isolate;
    animation: artifact-panel-float var(--float-duration) ease-in-out
      var(--float-delay) infinite alternate;
    will-change: transform;
  }

  .terminal-panel {
    --panel-x: var(--terminal-x);
    --panel-y: var(--terminal-y);
    --panel-w: var(--terminal-w);
    --panel-z: var(--terminal-z);
    --panel-mask: url("/img/home-artifacts/terminal-panel.png");
    --pointer-panel-x: var(--pointer-terminal-x);
    --pointer-panel-y: var(--pointer-terminal-y);
    --float-from-x: -1.5px;
    --float-from-y: 3px;
    --float-from-rotate: -0.07deg;
    --float-to-x: 2px;
    --float-to-y: -3.5px;
    --float-to-rotate: 0.08deg;
    --float-duration: 8.8s;
    --float-delay: -4.1s;
    background: transparent;
    container-type: inline-size;
  }

  .protein-panel {
    --panel-x: var(--protein-x);
    --panel-y: var(--protein-y);
    --panel-w: var(--protein-w);
    --panel-z: var(--protein-z);
    --panel-mask: url("/img/home-artifacts/protein-panel.png");
    --pointer-panel-x: var(--pointer-protein-x);
    --pointer-panel-y: var(--pointer-protein-y);
    --float-from-x: -3px;
    --float-from-y: 1.5px;
    --float-from-rotate: -0.1deg;
    --float-to-x: 3px;
    --float-to-y: -5.5px;
    --float-to-rotate: 0.12deg;
    --float-duration: 7.6s;
    --float-delay: -2.7s;
  }

  .map-panel {
    --map-paper-color: #f8eee3;
    --panel-x: var(--map-x);
    --panel-y: var(--map-y);
    --panel-w: var(--map-w);
    --panel-z: var(--map-z);
    --panel-mask: url("/img/home-artifacts/map-panel.png");
    --pointer-panel-x: var(--pointer-map-x);
    --pointer-panel-y: var(--pointer-map-y);
    --float-from-x: 2.3px;
    --float-from-y: 3px;
    --float-from-rotate: 0.085deg;
    --float-to-x: -3.2px;
    --float-to-y: -4px;
    --float-to-rotate: -0.1deg;
    --float-duration: 9.5s;
    --float-delay: -7.4s;
  }

  .data-panel {
    --panel-x: var(--data-x);
    --panel-y: var(--data-y);
    --panel-w: var(--data-w);
    --panel-z: var(--data-z);
    --panel-mask: url("/img/home-artifacts/data-panel.png");
    --pointer-panel-x: var(--pointer-data-x);
    --pointer-panel-y: var(--pointer-data-y);
    --float-from-x: -2px;
    --float-from-y: -2.5px;
    --float-from-rotate: -0.07deg;
    --float-to-x: 2.8px;
    --float-to-y: 3.5px;
    --float-to-rotate: 0.08deg;
    --float-duration: 8.9s;
    --float-delay: -3.8s;
  }

  .chess-panel {
    --panel-x: var(--chess-x);
    --panel-y: var(--chess-y);
    --panel-w: var(--chess-w);
    --panel-z: var(--chess-z);
    --panel-mask: url("/img/home-artifacts/chess-board.png");
    --pointer-panel-x: var(--pointer-chess-x);
    --pointer-panel-y: var(--pointer-chess-y);
    --float-from-x: 1.8px;
    --float-from-y: 3.2px;
    --float-from-rotate: 0.07deg;
    --float-to-x: -2.8px;
    --float-to-y: -3.3px;
    --float-to-rotate: -0.08deg;
    --float-duration: 10.2s;
    --float-delay: -8.1s;
  }

  @keyframes artifact-panel-float {
    from {
      transform: translate3d(
          calc(var(--pointer-panel-x) + var(--float-from-x)),
          calc(var(--pointer-panel-y) + var(--float-from-y)),
          0
        )
        rotate(var(--float-from-rotate));
    }

    to {
      transform: translate3d(
          calc(var(--pointer-panel-x) + var(--float-to-x)),
          calc(var(--pointer-panel-y) + var(--float-to-y)),
          0
        )
        rotate(var(--float-to-rotate));
    }
  }

  .panel-shadow,
  .panel-base {
    position: absolute;
    inset: 0;
  }

  .panel-shadow {
    z-index: 0;
    background: color-mix(in srgb, var(--ink) 21%, transparent);
    filter: blur(3px);
    opacity: 0.46;
    transform: translate3d(11px, 13px, -1px) scale(0.985);
    mask-image: var(--panel-mask);
    mask-position: center;
    mask-repeat: no-repeat;
    mask-size: contain;
    -webkit-mask-image: var(--panel-mask);
    -webkit-mask-position: center;
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-size: contain;
  }

  .panel-base {
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    user-select: none;
  }

  .terminal-copy {
    position: absolute;
    top: 36.5%;
    left: 25.2%;
    z-index: 2;
    width: 56.5%;
    margin: 0;
    border: 0;
    overflow: hidden;
    background: transparent;
    box-shadow: none;
    color: var(--terminal-text-color);
    font-family: var(--font-mono);
    font-size: clamp(3.4px, 0.32vw, 5.2px);
    font-size: clamp(3.4px, 1.25cqw, 5.2px);
    font-weight: 600;
    line-height: 1.17;
    letter-spacing: -0.025em;
    opacity: var(--terminal-text-opacity);
    transform: skewY(-13deg);
    transform-origin: top left;
    white-space: pre;
  }

  .terminal-copy code {
    font: inherit;
  }

  .terminal-light {
    position: absolute;
    z-index: 2;
    width: 0.82%;
    aspect-ratio: 1;
    border-radius: 50%;
    box-shadow: inset 0 -0.5px 0 rgba(43, 48, 56, 0.24);
    opacity: 0.9;
    transform: translate(-50%, -50%) skewY(-13deg) scaleY(0.84);
    pointer-events: none;
  }

  .terminal-light-red {
    top: 32.78%;
    left: 20%;
    background: #c65b50;
  }

  .terminal-light-yellow {
    top: 31.94%;
    left: 22.22%;
    background: #d1a43c;
  }

  .terminal-light-green {
    top: 31.25%;
    left: 24.44%;
    background: #4f9668;
  }

  .terminal-token {
    font: inherit;
  }

  .token-prompt {
    color: var(--terminal-prompt-color);
    font-weight: 800;
  }

  .token-command {
    color: var(--terminal-command-color);
  }

  .token-path {
    color: var(--terminal-path-color);
  }

  .token-meta {
    color: var(--terminal-meta-color);
  }

  .token-muted {
    color: var(--terminal-muted-color);
  }

  .terminal-cursor {
    display: inline-block;
    width: 0.72em;
    height: 0.9em;
    margin-left: 0.12em;
    background: currentColor;
    vertical-align: -0.08em;
    animation: terminal-blink 0.92s steps(1, end) infinite;
  }

  @keyframes terminal-blink {
    0%,
    52% {
      opacity: 1;
    }

    53%,
    100% {
      opacity: 0;
    }
  }

  .map-ripple {
    --ripple-color: #2c86ad;
    position: absolute;
    z-index: 3;
    width: 2%;
    aspect-ratio: 1;
    border: 1px solid var(--ripple-color);
    border-radius: 50%;
    opacity: 0;
    transform: translate(-50%, -50%) rotate(7deg) scaleY(0.56) scale(0.55);
    animation: map-ripple 5.8s cubic-bezier(0.2, 0.62, 0.35, 1) infinite;
    pointer-events: none;
  }

  .map-ripple-blue {
    top: 42.86%;
    left: 34.21%;
    animation-delay: -0.9s;
  }

  .map-ripple-amber {
    --ripple-color: #c98712;
    top: 55.74%;
    left: 65.01%;
    animation-delay: -4.1s;
  }

  @keyframes map-ripple {
    0%,
    34% {
      opacity: 0;
      transform: translate(-50%, -50%) rotate(7deg) scaleY(0.56) scale(0.55);
    }

    38% {
      opacity: 0.58;
    }

    70%,
    100% {
      opacity: 0;
      transform: translate(-50%, -50%) rotate(7deg) scaleY(0.56) scale(2.7);
    }
  }

  .map-marker-cover,
  .map-home-marker {
    position: absolute;
    pointer-events: none;
  }

  .map-marker-cover {
    z-index: 2;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--map-paper-color);
    box-shadow: 0 0 2px 1px var(--map-paper-color);
    transform: translate(-50%, -50%) rotate(7deg) scaleY(0.62);
  }

  .map-marker-cover-blue {
    top: 43.61%;
    left: 33.38%;
    width: 1.7%;
  }

  .map-marker-cover-amber {
    top: 55.83%;
    left: 63.8%;
    width: 2%;
  }

  .map-home-marker {
    z-index: 4;
    top: var(--marker-y);
    left: var(--marker-x);
    transform: translate(-50%, -50%) rotate(7deg) scaleY(0.62);
  }

  .map-home-marker-blue {
    --marker-x: 34.21%;
    --marker-y: 42.86%;
    width: 1.05%;
    aspect-ratio: 1;
    border-radius: 1px;
    background: #2c86ad;
  }

  .map-home-marker-amber {
    --marker-x: 65.01%;
    --marker-y: 55.74%;
    width: 1.65%;
    aspect-ratio: 1;
    border: 1px solid #c98712;
    border-radius: 50%;
    background: var(--map-paper-color);
  }

  .chess-position {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .chess-contact-layer {
    z-index: 2;
  }

  .chess-piece-layer {
    inset: auto;
    top: var(--chess-y);
    left: var(--chess-x);
    z-index: var(--chess-pieces-z);
    width: var(--chess-w);
    aspect-ratio: 3 / 2;
    animation: artifact-panel-float 10.2s ease-in-out -8.1s infinite alternate;
    will-change: transform;

    --float-from-x: 1.8px;
    --float-from-y: 3.2px;
    --float-from-rotate: 0.07deg;
    --float-to-x: -2.8px;
    --float-to-y: -3.3px;
    --float-to-rotate: -0.08deg;
    --pointer-panel-x: var(--pointer-chess-x);
    --pointer-panel-y: var(--pointer-chess-y);
  }

  .chess-piece {
    position: absolute;
    top: var(--piece-y);
    left: var(--piece-x);
    z-index: var(--piece-depth);
    width: var(--piece-width);
    transition:
      top 720ms cubic-bezier(0.22, 0.72, 0.2, 1),
      left 720ms cubic-bezier(0.22, 0.72, 0.2, 1);
  }

  @media (prefers-reduced-motion: no-preference) {
    .artifact-stack.is-chess-active .piece-white-king {
      top: calc(var(--piece-y) + 4.066%);
      left: calc(var(--piece-x) + 3.01%);
    }
  }

  .chess-piece img {
    position: absolute;
    bottom: 0;
    left: 0;
    z-index: 2;
    display: block;
    width: 100%;
    max-width: none;
    height: auto;
    transform: translate(var(--piece-anchor-x), var(--piece-base-pad));
    user-select: none;
  }

  .piece-shadow {
    position: absolute;
    top: 1px;
    left: 0;
    z-index: 1;
    width: 72%;
    aspect-ratio: 2.8;
    border-radius: 50%;
    background: #25313b;
    filter: blur(1.5px);
    opacity: 0.22;
    transform: translate(-50%, -42%);
  }

  :global(:root[data-theme="dark"]) .panel-base,
  :global(:root[data-theme="dark"]) .chess-piece img {
    filter: brightness(0.8) contrast(1.08) saturate(0.78);
  }

  :global(:root[data-theme="dark"]) .panel-shadow {
    opacity: 0.62;
  }

  :global(:root[data-theme="dark"]) .map-panel {
    --map-paper-color: #c7beb4;
  }

  @media (max-width: 980px) {
    .artifact-stack {
      --artifact-stage-w: clamp(440px, 60vw, 560px);
      left: calc(50% + clamp(20px, 6vw, 50px));
    }
  }

  @media (max-width: 680px) {
    .artifact-stack {
      --artifact-stage-w: clamp(440px, 112vw, 500px);
      --artifact-parallax-x: 11px;
      --artifact-parallax-y: 10px;
      --artifact-parallax-radius: 0.76;
    }
  }

  .artifact-stack.is-motion-paused .artifact-panel,
  .artifact-stack.is-motion-paused .chess-piece-layer,
  .artifact-stack.is-motion-paused .terminal-cursor,
  .artifact-stack.is-motion-paused .map-ripple {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .artifact-panel,
    .chess-piece-layer,
    .terminal-cursor,
    .map-ripple {
      animation: none;
    }

    .artifact-panel,
    .chess-piece-layer {
      transform: none;
    }

    .chess-piece {
      transition: none;
    }
  }

  :global(.artifact-debug-readout) {
    position: fixed;
    right: 10px;
    bottom: 10px;
    z-index: 9999;
    max-width: min(360px, calc(100vw - 20px));
    border: 1px solid rgba(43, 48, 56, 0.42);
    background: rgba(246, 241, 232, 0.94);
    box-shadow: 3px 3px 0 rgba(43, 48, 56, 0.28);
    color: #242a2f;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    line-height: 1.45;
    padding: 8px 10px;
    white-space: pre;
    pointer-events: none;
  }

  :global(:root[data-theme="dark"] .artifact-debug-readout) {
    border-color: rgba(232, 226, 214, 0.34);
    background: rgba(27, 27, 25, 0.92);
    box-shadow: 3px 3px 0 rgba(0, 0, 0, 0.45);
    color: #e8e2d6;
  }
</style>

<script>
  (() => {
    const motionQuery = window.matchMedia("(prefers-reduced-motion: no-preference)");

    document.querySelectorAll<HTMLElement>(".artifact-stack").forEach((stack) => {
      const hero = stack.closest<HTMLElement>(".hero-artifact");
      if (!hero) return;

      const layers = [
        { name: "terminal", selector: ".terminal-panel", depth: 0.38 },
        { name: "chess", selector: ".chess-panel", depth: 0.6 },
        { name: "data", selector: ".data-panel", depth: 0.75 },
        { name: "map", selector: ".map-panel", depth: 0.9 },
        { name: "protein", selector: ".protein-panel", depth: 1.1 },
      ].map((layer) => ({
        ...layer,
        node: stack.querySelector<HTMLElement>(layer.selector),
        targetX: 0,
        targetY: 0,
        currentX: 0,
        currentY: 0,
      }));
      const chessBoard = stack.querySelector<HTMLElement>(
        ".chess-panel .panel-base",
      );

      let frame = 0;
      let touchStart:
        | {
            pointerId: number;
            x: number;
            y: number;
            time: number;
          }
        | undefined;

      const getTravel = () => {
        const styles = window.getComputedStyle(stack);
        return {
          x: Number.parseFloat(styles.getPropertyValue("--artifact-parallax-x")) || 10,
          y: Number.parseFloat(styles.getPropertyValue("--artifact-parallax-y")) || 7,
          radius:
            Number.parseFloat(styles.getPropertyValue("--artifact-parallax-radius")) ||
            0.68,
        };
      };

      const render = () => {
        layers.forEach(({ name, currentX, currentY }) => {
          stack.style.setProperty(
            `--pointer-${name}-x`,
            `${currentX.toFixed(3)}px`,
          );
          stack.style.setProperty(
            `--pointer-${name}-y`,
            `${currentY.toFixed(3)}px`,
          );
        });
      };

      const tick = () => {
        let isMoving = false;

        layers.forEach((layer) => {
          layer.currentX += (layer.targetX - layer.currentX) * 0.13;
          layer.currentY += (layer.targetY - layer.currentY) * 0.13;

          if (
            Math.abs(layer.targetX - layer.currentX) > 0.01 ||
            Math.abs(layer.targetY - layer.currentY) > 0.01
          ) {
            isMoving = true;
          } else {
            layer.currentX = layer.targetX;
            layer.currentY = layer.targetY;
          }
        });

        render();

        if (isMoving) {
          frame = window.requestAnimationFrame(tick);
        } else {
          frame = 0;
        }
      };

      const schedule = () => {
        if (!frame) frame = window.requestAnimationFrame(tick);
      };

      const deactivate = () => {
        stack.classList.remove("is-chess-active");

        const isAtRest = layers.every(
          ({ targetX, targetY, currentX, currentY }) =>
            !targetX && !targetY && !currentX && !currentY,
        );
        if (isAtRest) return;

        layers.forEach((layer) => {
          layer.targetX = 0;
          layer.targetY = 0;
        });
        schedule();
      };

      const containsPoint = (clientX: number, clientY: number) => {
        const bounds = hero.getBoundingClientRect();
        return (
          clientX >= bounds.left &&
          clientX <= bounds.right &&
          clientY >= bounds.top &&
          clientY <= bounds.bottom
        );
      };

      const containsChessBoardPoint = (clientX: number, clientY: number) => {
        if (!chessBoard) return false;
        const bounds = chessBoard.getBoundingClientRect();
        return (
          clientX >= bounds.left &&
          clientX <= bounds.right &&
          clientY >= bounds.top &&
          clientY <= bounds.bottom
        );
      };

      const moveTowardPoint = (clientX: number, clientY: number) => {
        const travel = getTravel();
        let chessInfluence = 0;

        layers.forEach((layer) => {
          layer.targetX = 0;
          layer.targetY = 0;

          if (!layer.node) return;

          const rect = layer.node.getBoundingClientRect();
          const deltaX = clientX - (rect.left + rect.width / 2);
          const deltaY = clientY - (rect.top + rect.height / 2);
          const radius = Math.min(rect.width, rect.height) * travel.radius;
          const distance = Math.hypot(deltaX, deltaY);
          const normalizedDistance = distance / radius;
          const edgeProgress = Math.max(
            0,
            Math.min(1, (normalizedDistance - 0.15) / 0.85),
          );
          const smoothEdge =
            edgeProgress * edgeProgress * (3 - 2 * edgeProgress);
          const influence = 1 - smoothEdge;

          if (influence <= 0) return;

          layer.targetX =
            Math.max(-1, Math.min(1, deltaX / radius)) *
            travel.x *
            layer.depth *
            influence;
          layer.targetY =
            Math.max(-1, Math.min(1, deltaY / radius)) *
            travel.y *
            layer.depth *
            influence;

          if (layer.name === "chess") chessInfluence = influence;
        });

        stack.classList.toggle("is-chess-active", chessInfluence > 0.25);
        schedule();
      };

      window.addEventListener(
        "pointermove",
        (event) => {
          const hasPrecisePointer =
            event.pointerType === "mouse" || event.pointerType === "pen";

          if (!motionQuery.matches) {
            deactivate();
            return;
          }

          if (!hasPrecisePointer) return;

          if (!containsPoint(event.clientX, event.clientY)) {
            deactivate();
            return;
          }

          moveTowardPoint(event.clientX, event.clientY);
        },
        { passive: true },
      );

      window.addEventListener(
        "pointerdown",
        (event) => {
          if (
            !motionQuery.matches ||
            event.pointerType !== "touch" ||
            !containsChessBoardPoint(event.clientX, event.clientY)
          ) {
            touchStart = undefined;
            return;
          }

          touchStart = {
            pointerId: event.pointerId,
            x: event.clientX,
            y: event.clientY,
            time: event.timeStamp,
          };
        },
        { passive: true },
      );

      window.addEventListener(
        "pointerup",
        (event) => {
          if (
            !touchStart ||
            event.pointerType !== "touch" ||
            event.pointerId !== touchStart.pointerId
          ) {
            return;
          }

          const distance = Math.hypot(
            event.clientX - touchStart.x,
            event.clientY - touchStart.y,
          );
          const duration = event.timeStamp - touchStart.time;
          const isTap =
            distance <= 10 &&
            duration <= 350 &&
            containsChessBoardPoint(event.clientX, event.clientY);

          touchStart = undefined;
          if (!isTap) return;

          stack.classList.toggle("is-chess-active");
        },
        { passive: true },
      );

      window.addEventListener(
        "pointercancel",
        () => {
          touchStart = undefined;
        },
        { passive: true },
      );

      const visibilityObserver = new IntersectionObserver(
        ([entry]) => {
          stack.classList.toggle("is-motion-paused", !entry?.isIntersecting);
          if (!entry?.isIntersecting) deactivate();
        },
        { rootMargin: "120px 0px" },
      );
      visibilityObserver.observe(hero);

      window.addEventListener("blur", deactivate);
      motionQuery.addEventListener("change", deactivate);
    });
  })();

  (() => {
    const params = new URLSearchParams(window.location.search);
    const enabled =
      params.has("artifactDebug") ||
      window.localStorage.getItem("artifactDebug") === "1";

    if (!enabled) return;

    const readout = document.createElement("output");
    readout.className = "artifact-debug-readout";
    readout.setAttribute("aria-live", "off");
    document.body.append(readout);

    const px = (value) => `${Math.round(value)}px`;
    const getRect = (selector) =>
      document.querySelector(selector)?.getBoundingClientRect();
    const getFont = (selector) => {
      const node = document.querySelector(selector);
      return node ? window.getComputedStyle(node).fontSize : "n/a";
    };

    const update = () => {
      const hero = getRect(".hero-artifact");
      const stack = getRect(".artifact-stack");
      const terminal = getRect(".terminal-panel");

      readout.textContent = [
        `vw: ${window.innerWidth}px   vh: ${window.innerHeight}px`,
        `<=980: ${window.matchMedia("(max-width: 980px)").matches}`,
        `<=760: ${window.matchMedia("(max-width: 760px)").matches}`,
        `<=680: ${window.matchMedia("(max-width: 680px)").matches}`,
        `hero: ${hero ? `${px(hero.width)} x ${px(hero.height)}` : "hidden"}`,
        `stack: ${stack ? `${px(stack.width)} x ${px(stack.height)}` : "hidden"}`,
        `terminal: ${terminal ? `${px(terminal.width)} x ${px(terminal.height)}` : "hidden"}`,
        `terminal font: ${getFont(".terminal-copy")}`,
      ].join("\n");
    };

    window.addEventListener("resize", update, { passive: true });
    update();
  })();
</script>

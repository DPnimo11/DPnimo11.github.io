---
// src/components/HeroArtifactStack.astro
const terminalLines = [
  [
    { text: "$", tone: "prompt" },
    { text: " ls -la", tone: "command" },
  ],
  [
    { text: "drwxr-xr-x  ", tone: "muted" },
    { text: "trajectories/", tone: "path" },
  ],
  [
    { text: "-rw-r--r--  ", tone: "muted" },
    { text: "stops.parquet", tone: "path" },
  ],
  [
    { text: "-rw-r--r--  ", tone: "muted" },
    { text: "gyration.py", tone: "path" },
  ],
  [
    { text: "$", tone: "prompt" },
    { text: " python detect_stops.py --eps 50 --min-pts 4", tone: "command" },
  ],
  [
    { text: "[12:53]", tone: "meta" },
    { text: " loading 1.2M pings ..." },
  ],
  [
    { text: "[12:57]", tone: "meta" },
    { text: " clustering ... done" },
  ],
  [
    { text: "$", tone: "prompt" },
    { text: " lomonosov probe --dtm", tone: "command" },
  ],
  [{ text: "position: KQPKRBN" }],
  [{ text: "dtm: 549" }],
  [{ text: "best: Kf5" }],
  [
    { text: "$", tone: "prompt" },
    { text: ' cowsay "still running"', tone: "command" },
  ],
  [{ text: " _______________" }],
  [{ text: "< still running >" }],
  [{ text: " ---------------" }],
  [{ text: "        \\   ^__^" }],
  [{ text: "         \\  (oo)\\_______" }],
  [{ text: "            (__)\\       )\\/\\" }],
  [{ text: "                ||----w |" }],
  [{ text: "                ||     ||" }],
  [
    { text: "$", tone: "prompt" },
    { text: " " },
  ],
];

const chessPieces = [
  // Higher depth values render in front of lower ones. These values only
  // control piece-to-piece overlap; --chess-z controls the whole panel.
  {
    className: "black-knight",
    square: "b8",
    src: "/img/home-artifacts/chess-black-knight-v2.png",
    width: 320,
    height: 450,
    x: 20.351,
    y: 39.008,
    pieceWidth: 6.4,
    anchorX: -44.2,
    basePad: 8.4,
    depth: 2,
  },
  {
    className: "black-king",
    square: "d8",
    src: "/img/home-artifacts/chess-black-king-v2.png",
    width: 280,
    height: 490,
    x: 29.429,
    y: 35.865,
    pieceWidth: 5.9,
    anchorX: -44.3,
    basePad: 5.7,
    depth: 2,
  },
  {
    className: "white-queen",
    square: "g7",
    src: "/img/home-artifacts/chess-white-queen-v2.png",
    width: 260,
    height: 490,
    x: 46.057,
    y: 35.215,
    pieceWidth: 5.4,
    anchorX: -46.5,
    basePad: 5.3,
    depth: 3,
  },
  {
    className: "white-pawn",
    square: "g6",
    src: "/img/home-artifacts/chess-white-pawn-v2.png",
    width: 250,
    height: 370,
    x: 49.068,
    y: 39.281,
    pieceWidth: 6.1,
    anchorX: -37,
    basePad: 7,
    depth: 4,
  },
  {
    className: "white-king",
    square: "f6",
    src: "/img/home-artifacts/chess-white-king-v2.png",
    width: 290,
    height: 510,
    x: 44.529,
    y: 40.853,
    pieceWidth: 5.5,
    anchorX: -50.2,
    basePad: 3.7,
    depth: 5,
  },
  {
    className: "black-bishop",
    square: "h4",
    src: "/img/home-artifacts/chess-black-bishop-v2.png",
    width: 230,
    height: 470,
    x: 59.628,
    y: 45.84,
    pieceWidth: 5.3,
    anchorX: -40,
    basePad: 8.7,
    depth: 6,
  },
  {
    className: "black-rook",
    square: "b3",
    src: "/img/home-artifacts/chess-black-rook-v2.png",
    width: 300,
    height: 440,
    x: 35.403,
    y: 59.338,
    pieceWidth: 6.2,
    anchorX: -39,
    basePad: 9.1,
    depth: 7,
  },
];

const chessPieceStyle = (piece) =>
  `--piece-x: ${piece.x}%; --piece-y: ${piece.y}%; --piece-width: ${piece.pieceWidth}%; --piece-anchor-x: ${piece.anchorX}%; --piece-base-pad: ${piece.basePad}%; --piece-depth: ${piece.depth};`;
---

<div class="artifact-stack" aria-hidden="true">
  <section class="artifact-panel terminal-panel">
    <span class="panel-shadow"></span>
    <img
      class="panel-base"
      src="/img/home-artifacts/terminal-panel-final.png"
      width="1080"
      height="720"
      alt=""
      loading="eager"
      decoding="async"
      fetchpriority="high"
      draggable="false"
    />
    <pre class="terminal-copy"><code>{terminalLines.flatMap((line, lineIndex) => [
      ...line.map((token) => (
        <span class={`terminal-token token-${"tone" in token ? token.tone : "output"}`}>{token.text}</span>
      )),
      lineIndex < terminalLines.length - 1 ? "\n" : "",
    ])}<span class="terminal-cursor"></span></code></pre>
  </section>

  <section class="artifact-panel protein-panel">
    <span class="panel-shadow"></span>
    <img
      class="panel-base"
      src="/img/home-artifacts/protein-panel-final-v4.png"
      width="1080"
      height="720"
      alt=""
      loading="eager"
      decoding="async"
      draggable="false"
    />
  </section>

  <section class="artifact-panel map-panel">
    <span class="panel-shadow"></span>
    <img
      class="panel-base"
      src="/img/home-artifacts/map-panel-final.png"
      width="1080"
      height="720"
      alt=""
      loading="eager"
      decoding="async"
      draggable="false"
    />
  </section>

  <section class="artifact-panel data-panel">
    <span class="panel-shadow"></span>
    <img
      class="panel-base"
      src="/img/home-artifacts/data-panel-final-v3.png"
      width="1080"
      height="720"
      alt=""
      loading="eager"
      decoding="async"
      draggable="false"
    />
  </section>

  <section class="artifact-panel chess-panel">
    <span class="panel-shadow"></span>
    <img
      class="panel-base"
      src="/img/home-artifacts/chess-board-final-v4.png"
      width="1080"
      height="720"
      alt=""
      loading="eager"
      decoding="async"
      draggable="false"
    />
    <span class="chess-position chess-contact-layer">
      {
        chessPieces.map((piece) => (
          <span
            class={`chess-piece piece-${piece.className}`}
            data-square={piece.square}
            style={chessPieceStyle(piece)}
          >
            <span class="piece-shadow"></span>
          </span>
        ))
      }
    </span>
  </section>

  <span class="chess-position chess-piece-layer">
    {
      chessPieces.map((piece) => (
        <span
          class={`chess-piece piece-${piece.className}`}
          data-square={piece.square}
          style={chessPieceStyle(piece)}
        >
          <img
            src={piece.src}
            width={piece.width}
            height={piece.height}
            alt=""
            loading="eager"
            decoding="async"
            draggable="false"
          />
        </span>
      ))
    }
  </span>
</div>

<style>
  .artifact-stack {
    /*
     * QUICK TUNING CONTROLS
     * x/y move a panel, w changes its size, and z changes overlap order.
     * Percentages are relative to the full artifact viewport.
     */
    --terminal-x: 5%;
    --terminal-y: 5%;
    --terminal-w: 57%;
    --terminal-z: 1;

    --protein-x: 30%;
    --protein-y: 25%;
    --protein-w: 50%;
    --protein-z: 5;

    --map-x: 7%;
    --map-y: 37%;
    --map-w: 50%;
    --map-z: 4;

    --data-x: 38%;
    --data-y: 47%;
    --data-w: 50%;
    --data-z: 3;

    --chess-x: 18%;
    --chess-y: 60%;
    --chess-w: 50%;
    --chess-z: 2;
    --chess-pieces-z: 6;

    /* Any CSS color works here: #315e72, #c89b4a, rgb(...), etc. */
    --terminal-text-color: #2b3038;
    --terminal-command-color: #252b31;
    --terminal-path-color: #315e72;
    --terminal-meta-color: #59656a;
    --terminal-muted-color: #5d686c;
    --terminal-prompt-color: #2e7d56;
    --terminal-text-opacity: 0.82;
    --artifact-stage-w: min(112%, 680px);

    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    width: var(--artifact-stage-w);
    aspect-ratio: 1.16 / 1;
    container-type: inline-size;
    overflow: visible;
    pointer-events: none;
    transform: translate(-50%, -50%);
  }

  .artifact-panel {
    --panel-x: 0%;
    --panel-y: 0%;
    --panel-w: 50%;
    --panel-z: 1;
    --panel-mask: none;
    position: absolute;
    top: var(--panel-y);
    left: var(--panel-x);
    z-index: var(--panel-z);
    width: var(--panel-w);
    aspect-ratio: 3 / 2;
    background: transparent;
    color: inherit;
    isolation: isolate;
  }

  .terminal-panel {
    --panel-x: var(--terminal-x);
    --panel-y: var(--terminal-y);
    --panel-w: var(--terminal-w);
    --panel-z: var(--terminal-z);
    --panel-mask: url("/img/home-artifacts/terminal-panel-final.png");
    background: transparent;
    container-type: inline-size;
  }

  .protein-panel {
    --panel-x: var(--protein-x);
    --panel-y: var(--protein-y);
    --panel-w: var(--protein-w);
    --panel-z: var(--protein-z);
    --panel-mask: url("/img/home-artifacts/protein-panel-final-v4.png");
  }

  .map-panel {
    --panel-x: var(--map-x);
    --panel-y: var(--map-y);
    --panel-w: var(--map-w);
    --panel-z: var(--map-z);
    --panel-mask: url("/img/home-artifacts/map-panel-final.png");
  }

  .data-panel {
    --panel-x: var(--data-x);
    --panel-y: var(--data-y);
    --panel-w: var(--data-w);
    --panel-z: var(--data-z);
    --panel-mask: url("/img/home-artifacts/data-panel-final-v3.png");
  }

  .chess-panel {
    --panel-x: var(--chess-x);
    --panel-y: var(--chess-y);
    --panel-w: var(--chess-w);
    --panel-z: var(--chess-z);
    --panel-mask: url("/img/home-artifacts/chess-board-final-v4.png");
  }

  .panel-shadow,
  .panel-base {
    position: absolute;
    inset: 0;
  }

  .panel-shadow {
    z-index: 0;
    background: color-mix(in srgb, var(--ink) 21%, transparent);
    filter: blur(3px);
    opacity: 0.46;
    transform: translate3d(11px, 13px, -1px) scale(0.985);
    mask-image: var(--panel-mask);
    mask-position: center;
    mask-repeat: no-repeat;
    mask-size: contain;
    -webkit-mask-image: var(--panel-mask);
    -webkit-mask-position: center;
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-size: contain;
  }

  .panel-base {
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    user-select: none;
  }

  .terminal-copy {
    position: absolute;
    top: 36.5%;
    left: 25.2%;
    z-index: 2;
    width: 56.5%;
    margin: 0;
    border: 0;
    overflow: hidden;
    background: transparent;
    box-shadow: none;
    color: var(--terminal-text-color);
    font-family: var(--font-mono);
    font-size: clamp(3.4px, 0.32vw, 5.2px);
    font-size: clamp(3.4px, 1.25cqw, 5.2px);
    font-weight: 600;
    line-height: 1.17;
    letter-spacing: -0.025em;
    opacity: var(--terminal-text-opacity);
    transform: skewY(-13deg);
    transform-origin: top left;
    white-space: pre;
  }

  .terminal-copy code {
    font: inherit;
  }

  .terminal-token {
    font: inherit;
  }

  .token-prompt {
    color: var(--terminal-prompt-color);
    font-weight: 800;
  }

  .token-command {
    color: var(--terminal-command-color);
  }

  .token-path {
    color: var(--terminal-path-color);
  }

  .token-meta {
    color: var(--terminal-meta-color);
  }

  .token-muted {
    color: var(--terminal-muted-color);
  }

  .terminal-cursor {
    display: inline-block;
    width: 0.72em;
    height: 0.9em;
    margin-left: 0.12em;
    background: currentColor;
    vertical-align: -0.08em;
  }

  .chess-position {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .chess-contact-layer {
    z-index: 2;
  }

  .chess-piece-layer {
    inset: auto;
    top: var(--chess-y);
    left: var(--chess-x);
    z-index: var(--chess-pieces-z);
    width: var(--chess-w);
    aspect-ratio: 3 / 2;
  }

  .chess-piece {
    position: absolute;
    top: var(--piece-y);
    left: var(--piece-x);
    z-index: var(--piece-depth);
    width: var(--piece-width);
  }

  .chess-piece img {
    position: absolute;
    bottom: 0;
    left: 0;
    z-index: 2;
    display: block;
    width: 100%;
    max-width: none;
    height: auto;
    transform: translate(var(--piece-anchor-x), var(--piece-base-pad));
    user-select: none;
  }

  .piece-shadow {
    position: absolute;
    top: 1px;
    left: 0;
    z-index: 1;
    width: 72%;
    aspect-ratio: 2.8;
    border-radius: 50%;
    background: #25313b;
    filter: blur(1.5px);
    opacity: 0.22;
    transform: translate(-50%, -42%);
  }

  :global(:root[data-theme="dark"]) .panel-base,
  :global(:root[data-theme="dark"]) .chess-piece img {
    filter: brightness(0.8) contrast(1.08) saturate(0.78);
  }

  :global(:root[data-theme="dark"]) .terminal-copy {
    --terminal-command-color: #d5d0c4;
    --terminal-path-color: #93abc0;
    --terminal-meta-color: #9fa8a3;
    --terminal-muted-color: #909a96;
    --terminal-prompt-color: #7fb48e;
    opacity: 0.7;
  }

  :global(:root[data-theme="dark"]) .panel-shadow {
    opacity: 0.62;
  }

  @media (max-width: 980px) {
    .artifact-stack {
      --artifact-stage-w: clamp(440px, 60vw, 560px);
    }
  }

  :global(.artifact-debug-readout) {
    position: fixed;
    right: 10px;
    bottom: 10px;
    z-index: 9999;
    max-width: min(360px, calc(100vw - 20px));
    border: 1px solid rgba(43, 48, 56, 0.42);
    background: rgba(246, 241, 232, 0.94);
    box-shadow: 3px 3px 0 rgba(43, 48, 56, 0.28);
    color: #242a2f;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    line-height: 1.45;
    padding: 8px 10px;
    white-space: pre;
    pointer-events: none;
  }

  :global(:root[data-theme="dark"] .artifact-debug-readout) {
    border-color: rgba(232, 226, 214, 0.34);
    background: rgba(27, 27, 25, 0.92);
    box-shadow: 3px 3px 0 rgba(0, 0, 0, 0.45);
    color: #e8e2d6;
  }
</style>

<script>
  (() => {
    const params = new URLSearchParams(window.location.search);
    const enabled =
      params.has("artifactDebug") ||
      window.localStorage.getItem("artifactDebug") === "1";

    if (!enabled) return;

    const readout = document.createElement("output");
    readout.className = "artifact-debug-readout";
    readout.setAttribute("aria-live", "off");
    document.body.append(readout);

    const px = (value) => `${Math.round(value)}px`;
    const getRect = (selector) =>
      document.querySelector(selector)?.getBoundingClientRect();
    const getFont = (selector) => {
      const node = document.querySelector(selector);
      return node ? window.getComputedStyle(node).fontSize : "n/a";
    };

    const update = () => {
      const hero = getRect(".hero-artifact");
      const stack = getRect(".artifact-stack");
      const terminal = getRect(".terminal-panel");

      readout.textContent = [
        `vw: ${window.innerWidth}px   vh: ${window.innerHeight}px`,
        `<=980: ${window.matchMedia("(max-width: 980px)").matches}`,
        `<=760: ${window.matchMedia("(max-width: 760px)").matches}`,
        `<=680: ${window.matchMedia("(max-width: 680px)").matches}`,
        `hero: ${hero ? `${px(hero.width)} x ${px(hero.height)}` : "hidden"}`,
        `stack: ${stack ? `${px(stack.width)} x ${px(stack.height)}` : "hidden"}`,
        `terminal: ${terminal ? `${px(terminal.width)} x ${px(terminal.height)}` : "hidden"}`,
        `terminal font: ${getFont(".terminal-copy")}`,
      ].join("\n");
    };

    window.addEventListener("resize", update, { passive: true });
    update();
  })();
</script>

---
import DemoPanel from "../../components/DemoPanel.astro";
import ProjectVisual from "../../components/ProjectVisual.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects } from "../../data/projects";
import { absoluteUrl, site } from "../../data/site";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const projectUrl = absoluteUrl(`/projects/${project.slug}/`);
const projectJsonLd = {
  "@type": "CreativeWork",
  "@id": `${projectUrl}#creativework`,
  name: project.title,
  headline: project.title,
  description: project.summary,
  url: projectUrl,
  creator: { "@id": `${site.url}/#person` },
  dateCreated: project.year,
  keywords: [project.kicker, project.status, ...project.stack].join(", "),
  sameAs: project.links.map((link) => link.href),
  image: project.image ? absoluteUrl(project.image) : absoluteUrl(site.socialImage),
};
---

<BaseLayout title={`${project.title} | Darren Wang`} description={project.summary} jsonLd={projectJsonLd}>
  <article class="project-detail">
    <a class="back-link" href="/projects/">Back to projects</a>
    <header class="detail-hero">
      <div>
        <p class="eyebrow">{project.kicker} / {project.status}</p>
        <h1>{project.title}</h1>
        <p>{project.summary}</p>
        <div class="action-row">
          {project.links.map((link) => <a class="button" href={link.href} target="_blank" rel="noreferrer">{link.label}</a>)}
        </div>
      </div>
      <div class="detail-visual-stack">
        <ProjectVisual
          variant={project.visual}
          image={project.image}
          frameBackground={project.thumbnailFrameBackground}
          slug={project.slug}
          title={project.title}
        />
        {
          project.imageAttribution && (
            <p class="image-attribution">
              Thumbnail artwork:{" "}
              <a href={project.imageAttribution.sourceHref} target="_blank" rel="noreferrer">
                {project.imageAttribution.title}
              </a>{" "}
              by{" "}
              <a href={project.imageAttribution.creatorHref} target="_blank" rel="noreferrer">
                {project.imageAttribution.creator}
              </a>
              , licensed under{" "}
              <a href={project.imageAttribution.licenseHref} target="_blank" rel="noreferrer">
                {project.imageAttribution.license}
              </a>
              . Displayed unmodified and scaled for layout.
            </p>
          )
        }
      </div>
    </header>

    <DemoPanel project={project} />

    <section class="detail-grid">
      <div class="detail-copy">
        <h2>Problem</h2>
        <p>{project.problem}</p>
        <h2>Approach</h2>
        <p>{project.approach}</p>
        <h2>Result</h2>
        <p>{project.result}</p>
      </div>
      <aside class="fact-panel">
        <div>
          <span>Year</span>
          <strong>{project.year}</strong>
        </div>
        <div>
          <span>Stack</span>
          <div class="tag-row">{project.stack.map((tag) => <span>{tag}</span>)}</div>
        </div>
        <div>
          <span>Highlights</span>
          <ul>
            {project.highlights.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div>
          <span>Signals</span>
          <ul>
            {project.metrics.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </aside>
    </section>
  </article>
</BaseLayout>

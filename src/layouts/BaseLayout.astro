---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Darren Wang | Software, research, robotics",
  description = "Portfolio of Darren Wang, a Penn CIS and Robotics student building software, research tooling, and interactive systems.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f1e8" />
    <link rel="icon" id="dynamic-favicon" type="image/svg+xml" href="/favicon-light.svg" />
    <script is:inline>
      const setFavicon = (isDark) => {
        const favicon = document.getElementById("dynamic-favicon");
        if (favicon) favicon.href = isDark ? "/favicon-dark.svg" : "/favicon-light.svg";
      };
      const mq = window.matchMedia("(prefers-color-scheme: dark)");
      setFavicon(mq.matches);
      mq.addEventListener("change", (e) => setFavicon(e.matches));
    </script>
    <title>{title}</title>
  </head>
  <body>
    <div class="page-shell">
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

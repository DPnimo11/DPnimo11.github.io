      const fragment = document.createDocumentFragment();

      signals.forEach((signal) => {
        const row = document.createElement("div");
        const meta = document.createElement("div");
        const label = document.createElement("span");
        const detail = document.createElement("em");
        const track = document.createElement("div");
        const fill = document.createElement("i");
        const value = document.createElement("strong");

        row.className = `azure-signal ${signal.value < 0 ? "lowers" : "raises"}`;
        meta.className = "azure-signal-meta";
        track.className = "azure-signal-track";

        label.textContent = signal.label;
        detail.textContent = signal.detail;
        fill.style.width = `${Math.min(Math.abs(signal.value), 100)}%`;
        value.textContent = `${signal.value > 0 ? "+" : ""}${signal.value}`;

        meta.append(label, detail);
        track.append(fill);
        row.append(meta, track, value);
        fragment.append(row);
      });

      signalsNode.replaceChildren(fragment);
    };

    const render = () => {
      const item = cases[activeCase] || cases.baseline;
      const threshold = Number(thresholdInput?.value || 55);
      const isCritical = item.score >= threshold;
      const metrics = metricsForThreshold(threshold);

      if (kindNode) kindNode.textContent = item.kind;
      if (titleNode) titleNode.textContent = item.title;
      if (scoreNode) scoreNode.textContent = formatPercent(item.score);
      if (noteNode) noteNode.textContent = item.note;
      if (thresholdNode) thresholdNode.textContent = formatPercent(threshold);
      if (gaugeNode) gaugeNode.style.width = formatPercent(item.score);
      if (thresholdMarker) thresholdMarker.style.left = formatPercent(threshold);
      if (decisionNode) {
        decisionNode.textContent = isCritical
          ? "Escalate to criticality triage"
          : "Route to standard provisioning queue";
        decisionNode.classList.toggle("critical", isCritical);
      }
      if (signalSummaryNode) signalSummaryNode.textContent = item.summary;

      metricNodes.tp && (metricNodes.tp.textContent = String(metrics.tp));
      metricNodes.fp && (metricNodes.fp.textContent = String(metrics.fp));
      metricNodes.fn && (metricNodes.fn.textContent = String(metrics.fn));
      metricNodes.tn && (metricNodes.tn.textContent = String(metrics.tn));
      metricNodes.precision && (metricNodes.precision.textContent = formatRatio(metrics.precision));
      metricNodes.recall && (metricNodes.recall.textContent = formatRatio(metrics.recall));
      metricNodes.f1 && (metricNodes.f1.textContent = formatRatio(metrics.f1));
      metricNodes.reviewRate && (metricNodes.reviewRate.textContent = formatRatio(metrics.reviewRate));

      caseButtons.forEach((button) => {
        const isActive = button.dataset.azureCase === activeCase;
        button.classList.toggle("active", isActive);
        button.setAttribute("aria-pressed", String(isActive));
      });

      renderSignals(item.signals);
    };

    caseButtons.forEach((button) => {
      button.addEventListener("click", () => {
        activeCase = button.dataset.azureCase || "baseline";
        render();
      });
    });

    thresholdInput?.addEventListener("input", render);

    render();
  })();

  (() => {
    const root = document.querySelector("[data-leetloop-demo]");
    if (!root) return;

    const list = root.querySelector("[data-review-list]");
    const dueCount = root.querySelector("[data-due-count]");
    const items = [
      { title: "Binary Search", tag: "arrays", due: "now", interval: 1 },
      { title: "Course Schedule", tag: "graphs", due: "today", interval: 3 },
      { title: "LRU Cache", tag: "design", due: "tomorrow", interval: 7 },
    ];
    let cursor = 0;

    const render = () => {
      if (!list || !dueCount) return;
      list.innerHTML = items
        .map((item, index) => `
          <article class="review-row ${index === cursor ? "active" : ""}">
            <div>
              <strong>${item.title}</strong>
              <span>${item.tag} / interval ${item.interval}d</span>
            </div>
            <em>${item.due}</em>
          </article>
        `)
        .join("");
      dueCount.textContent = `${items.filter((item) => item.due !== "later").length} due`;
    };

    root.querySelectorAll("[data-review-action]").forEach((button) => {
      button.addEventListener("click", () => {
        const active = items[cursor];
        if (!active) return;
        if (button.dataset.reviewAction === "solved") {
          active.interval = Math.min(active.interval * 2, 30);
          active.due = "later";
        } else {
          active.interval = 1;
          active.due = "now";
        }
        cursor = (cursor + 1) % items.length;
        render();
      });
    });

    render();
  })();
</script>

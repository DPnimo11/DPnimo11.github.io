---
---
<section class="demo-panel hiring-panel" aria-labelledby="demo-title">
  <div class="panel-heading">
    <p class="eyebrow">Interactive swipe</p>
    <h2 id="demo-title">Candidate screening and outreach</h2>
  </div>
  <div class="hiring-demo-container">
    <div class="hiring-card-stack" id="hiringCardStack">
      <div class="hiring-card" id="hiringCard">
        <div class="hiring-overlay hiring-overlay-dislike">
          <div class="hiring-overlay-icon">✕</div>
        </div>
        <div class="hiring-overlay hiring-overlay-like">
          <div class="hiring-overlay-icon">✓</div>
        </div>
        <div class="hiring-card-header">
          <div class="hiring-card-profile">
            <div class="hiring-avatar">👤</div>
            <div class="hiring-info">
              <h3 class="candidate-name">Alice Chen</h3>
              <div class="hiring-exp">💼 4 years</div>
            </div>
          </div>
          <div class="hiring-skills">
            <span class="hiring-skill">React</span>
            <span class="hiring-skill">Next.js</span>
            <span class="hiring-skill">Node.js</span>
            <span class="hiring-skill">TypeScript</span>
          </div>
        </div>
        <div class="hiring-card-body">
          <div>
            <div class="hiring-section-title">Key Strengths</div>
            <ul class="hiring-strengths">
              <li>Led migration to Next.js reducing load times by 40%.</li>
              <li>Built robust GraphQL APIs for core services.</li>
            </ul>
          </div>
          <div>
            <div class="hiring-section-title">Standout Project</div>
            <div class="hiring-project">Developed an internal analytics dashboard using React and D3 to track user engagement.</div>
          </div>
          <div class="hiring-summary">
            "Strong frontend candidate with a solid grasp of React performance optimization and backend data fetching."
          </div>
        </div>
        <div class="hiring-card-footer">
          <div class="hiring-hint">Swipe right to LIKE, left to DISLIKE</div>
        </div>
      </div>
      
      <div class="hiring-card hiring-card-active">
        <div class="hiring-overlay hiring-overlay-dislike">
          <div class="hiring-overlay-icon">✕</div>
        </div>
        <div class="hiring-overlay hiring-overlay-like">
          <div class="hiring-overlay-icon">✓</div>
        </div>
        <div class="hiring-card-header" style="background: linear-gradient(135deg, #2e7d32, #1b5e20);">
          <div class="hiring-card-profile">
            <div class="hiring-avatar">👤</div>
            <div class="hiring-info">
              <h3 class="candidate-name">Bob Smith</h3>
              <div class="hiring-exp">💼 2 years</div>
            </div>
          </div>
          <div class="hiring-skills">
            <span class="hiring-skill">Python</span>
            <span class="hiring-skill">Django</span>
            <span class="hiring-skill">PostgreSQL</span>
          </div>
        </div>
        <div class="hiring-card-body">
          <div>
            <div class="hiring-section-title">Key Strengths</div>
            <ul class="hiring-strengths">
              <li>Built REST APIs for mobile clients.</li>
              <li>Optimized database queries.</li>
            </ul>
          </div>
          <div>
            <div class="hiring-section-title">Standout Project</div>
            <div class="hiring-project">Created a web scraper using Python and BeautifulSoup to aggregate tech news.</div>
          </div>
          <div class="hiring-summary">
            "Junior backend developer with good Python fundamentals but lacks scalability experience."
          </div>
        </div>
        <div class="hiring-card-footer">
          <div class="hiring-hint">Swipe right to LIKE, left to DISLIKE</div>
        </div>
      </div>
      
      <div class="hiring-email-view" id="hiringEmailView">
        <div class="hiring-email-header">
          <p><strong>To:</strong> <span id="emailToName"></span></p>
          <p><strong>Subject:</strong> Software Engineer Role at NexHacks</p>
        </div>
        <div class="hiring-email-body" id="emailBodyContent">
          <!-- Populated by JS -->
        </div>
        <div class="hiring-email-actions">
          <button class="hiring-btn primary" id="hiringNextEmailBtn" style="display: none;">Next Draft</button>
          <button class="hiring-btn" id="hiringResetBtn">Reset Demo</button>
        </div>
      </div>

      <div class="hiring-end-screen" id="hiringEndScreen">
        <div class="hiring-end-content">
          <h3>Batch Complete</h3>
          <p id="hiringEndSubtitle">0 prospective candidates selected</p>
          <div class="hiring-end-actions">
            <button class="hiring-btn" id="hiringResetBtn2">Reset Demo</button>
            <button class="hiring-btn primary" id="hiringDraftEmailsBtn" style="display: none;">Draft Emails</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const stack = document.getElementById('hiringCardStack');
    const emailView = document.getElementById('hiringEmailView');
    const endScreen = document.getElementById('hiringEndScreen');
    const endSubtitle = document.getElementById('hiringEndSubtitle');
    const draftBtn = document.getElementById('hiringDraftEmailsBtn');
    const nextEmailBtn = document.getElementById('hiringNextEmailBtn');
    const emailBodyContent = document.getElementById('emailBodyContent');
    
    if (!stack || !emailView || !endScreen) return;

    let isDragging = false;
    let startX = 0;
    let currentX = 0;
    let acceptedNames = [];
    let currentEmailIndex = 0;
    
    const personalizedEmails = {
      'Alice': `Hi Alice,\n\nI was really impressed by your background, particularly your work migrating to Next.js and improving load times by 40%.\n\nWe are currently looking for a strong frontend engineer to help scale our platform, and your experience with React and Node.js aligns perfectly with our stack. I'd love to chat and share more about what we're building.\n\nAre you free for a quick call sometime this week?\n\nBest,\nDarren`,
      'Bob': `Hi Bob,\n\nI was impressed by your backend projects, particularly the web scraper you built using Python and BeautifulSoup.\n\nWe are currently looking for a backend engineer to help scale our platform, and your experience with Django and PostgreSQL aligns well with what we're building. I'd love to chat and share more about the role.\n\nAre you free for a quick call sometime this week?\n\nBest,\nDarren`
    };
    
    // Get all cards and set z-index
    let cards = Array.from(stack.querySelectorAll('.hiring-card'));
    const initCards = () => {
      cards.forEach((c, i) => {
        c.style.zIndex = cards.length - i;
        c.style.setProperty('--x', '0px');
        c.style.setProperty('--rot', '0deg');
        c.style.opacity = '1';
        c.classList.remove('animating');
        
        const likeOverlay = c.querySelector('.hiring-overlay-like');
        const dislikeOverlay = c.querySelector('.hiring-overlay-dislike');
        if (likeOverlay) likeOverlay.style.setProperty('--overlay-op', '0');
        if (dislikeOverlay) dislikeOverlay.style.setProperty('--overlay-op', '0');
      });
    };
    
    initCards();

    const getActiveCard = () => cards[0];

    const onPointerDown = (e) => {
      const card = getActiveCard();
      if (!card || e.target.closest('.hiring-email-view')) return;
      isDragging = true;
      startX = e.clientX;
      card.classList.remove('animating');
      card.setPointerCapture(e.pointerId);
    };

    const onPointerMove = (e) => {
      if (!isDragging) return;
      currentX = e.clientX - startX;
      updateCard();
    };

    const onPointerUp = (e) => {
      if (!isDragging) return;
      isDragging = false;
      const card = getActiveCard();
      if (!card) return;
      
      card.classList.add('animating');
      card.releasePointerCapture(e.pointerId);

      const threshold = 80;

      if (currentX > threshold) {
        // Swipe right (Like)
        currentX = window.innerWidth > 600 ? 500 : 300;
        updateCard();
        
        const nameNode = card.querySelector('.candidate-name');
        if (nameNode) {
          acceptedNames.push(nameNode.textContent.trim().split(' ')[0]);
        }
        
        setTimeout(() => {
          card.style.display = 'none';
          cards.shift();
          currentX = 0;
          checkEndState();
        }, 350);
      } else if (currentX < -threshold) {
        // Swipe left (Pass)
        currentX = window.innerWidth > 600 ? -500 : -300;
        updateCard();
        setTimeout(() => {
          card.style.display = 'none';
          cards.shift();
          currentX = 0;
          checkEndState();
        }, 350);
      } else {
        // Spring back
        currentX = 0;
        updateCard();
      }
    };

    const checkEndState = () => {
      if (cards.length === 0) {
        endSubtitle.textContent = `${acceptedNames.length} prospective candidate${acceptedNames.length === 1 ? '' : 's'} selected`;
        draftBtn.style.display = acceptedNames.length > 0 ? 'block' : 'none';
        endScreen.classList.add('active');
      }
    };

    const updateCard = () => {
      const card = getActiveCard();
      if (!card) return;

      const rot = currentX * 0.05;
      card.style.setProperty('--x', `${currentX}px`);
      card.style.setProperty('--rot', `${rot}deg`);
      
      const likeOverlay = card.querySelector('.hiring-overlay-like');
      const dislikeOverlay = card.querySelector('.hiring-overlay-dislike');
      
      if (currentX > 0) {
        likeOverlay.style.setProperty('--overlay-op', Math.min(1, currentX / 100));
        dislikeOverlay.style.setProperty('--overlay-op', 0);
      } else {
        dislikeOverlay.style.setProperty('--overlay-op', Math.min(1, Math.abs(currentX) / 100));
        likeOverlay.style.setProperty('--overlay-op', 0);
      }
      
      if (Math.abs(currentX) > 200 && !isDragging) {
        card.style.opacity = '0';
      } else {
        card.style.opacity = '1';
      }
    };

    const resetDemo = () => {
      emailView.classList.remove('active');
      endScreen.classList.remove('active');
      currentX = 0;
      acceptedNames = [];
      cards = Array.from(stack.querySelectorAll('.hiring-card'));
      cards.forEach(c => c.style.display = 'flex');
      initCards();
    };

    stack.addEventListener('pointerdown', onPointerDown);
    stack.addEventListener('pointermove', onPointerMove);
    stack.addEventListener('pointerup', onPointerUp);
    stack.addEventListener('pointercancel', onPointerUp);

    document.getElementById('hiringResetBtn')?.addEventListener('click', resetDemo);
    document.getElementById('hiringResetBtn2')?.addEventListener('click', resetDemo);
    const renderEmail = () => {
      if (currentEmailIndex >= acceptedNames.length) return;
      const firstName = acceptedNames[currentEmailIndex];
      document.getElementById('emailToName').textContent = firstName.toLowerCase() + '@example.com';
      
      const emailText = personalizedEmails[firstName] || `Hi ${firstName},\n\nWe were impressed by your background and would love to chat.\n\nBest,\nDarren`;
      emailBodyContent.textContent = emailText;
      emailBodyContent.scrollTop = 0;

      if (currentEmailIndex < acceptedNames.length - 1) {
        nextEmailBtn.style.display = 'block';
        document.getElementById('hiringResetBtn').style.display = 'none';
      } else {
        nextEmailBtn.style.display = 'none';
        document.getElementById('hiringResetBtn').style.display = 'block';
      }
    };

    nextEmailBtn?.addEventListener('click', () => {
      currentEmailIndex++;
      renderEmail();
    });

    draftBtn?.addEventListener('click', () => {
      if (acceptedNames.length > 0) {
        currentEmailIndex = 0;
        renderEmail();
      }
      emailView.classList.add('active');
    });
  })();
</script>

---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Resume | Darren Wang" description="Darren Wang's Resume">
  <section class="resume-hero">
    <div class="resume-copy">
      <h1>Resume</h1>
      <p>My most recent resume is embedded below. If it doesn't load automatically, you can <a href="/Darren_Wang_Resume.pdf" target="_blank" rel="noopener noreferrer">download the PDF here</a>.</p>
    </div>
    <div class="resume-container">
      <object data="/Darren_Wang_Resume.pdf" type="application/pdf" width="100%" height="100%">
        <p>Unable to display PDF file. <a href="/Darren_Wang_Resume.pdf">Download</a> instead.</p>
      </object>
    </div>
  </section>
</BaseLayout>

<style>
  .resume-hero {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-top: 40px;
    margin-bottom: 80px;
  }
  .resume-copy {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .resume-copy h1 {
    font-size: 2rem;
    color: var(--color-text);
  }
  .resume-copy p {
    color: var(--color-text-muted);
  }
  .resume-copy a {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .resume-copy a:hover {
    color: var(--color-accent);
  }
  .resume-container {
    width: 100%;
    max-width: 850px;
    margin: 0 auto;
    height: 75vh;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.4);
    background-color: var(--color-panel-bg);
    border: 1px solid var(--color-border);
  }
  object {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

---
const objects = [
  { id: 'apple', label: 'Apple' },
  { id: 'brick', label: 'Brick' },
  { id: 'mug', label: 'Coffee Mug' },
  { id: 'basketball', label: 'Basketball' }
];
---

<section class="demo-panel collision-demo-panel" aria-labelledby="demo-title">
  <div class="panel-heading">
    <p class="eyebrow">Interactive Demo</p>
    <h2 id="demo-title">Material Collision Simulator</h2>
  </div>

  <div class="collision-arena">
    <div class="collision-selector" id="collisionSelector">
      <h3>Select 2 objects to collide:</h3>
      <div class="object-grid">
        {objects.map((obj) => (
          <button type="button" class="object-btn" data-id={obj.id}>
            <span class="object-icon"></span>
            <span class="object-label">{obj.label}</span>
          </button>
        ))}
      </div>
      <div class="selection-status">
        <span id="selectionCount">0 / 2 selected</span>
        <button type="button" class="button simulate-btn" id="simulateBtn" disabled>Simulate</button>
      </div>
    </div>

    <div class="collision-terminal" id="collisionTerminal" hidden>
      <div class="terminal-log" id="terminalLog"></div>
    </div>

    <div class="collision-video-container" id="collisionVideoContainer" hidden>
      <div class="video-header">
        <button type="button" class="back-btn" id="backToSelectorBtn">← Back to selection</button>
        <strong id="videoTitle">Apple vs Brick</strong>
      </div>
      <div class="collision-video-frame">
        <video id="collisionVideoPlayer" controls playsinline preload="metadata" poster="/img/collision.jpg">
          <source id="collisionVideoSource" src="/video/collision.mp4" type="video/mp4" />
          <a href="/video/collision.mp4">Open the collision video</a>
        </video>
      </div>
    </div>
  </div>
</section>

<script>
  const selector = document.getElementById('collisionSelector');
  const terminal = document.getElementById('collisionTerminal');
  const terminalLog = document.getElementById('terminalLog');
  const videoContainer = document.getElementById('collisionVideoContainer');
  const objectBtns = document.querySelectorAll('.object-btn');
  const simulateBtn = document.getElementById('simulateBtn') as HTMLButtonElement;
  const backBtn = document.getElementById('backToSelectorBtn');
  const selectionCount = document.getElementById('selectionCount');
  const videoPlayer = document.getElementById('collisionVideoPlayer') as HTMLVideoElement;
  const videoSource = document.getElementById('collisionVideoSource') as HTMLSourceElement;
  const videoTitle = document.getElementById('videoTitle');

  let selectedObjects: string[] = [];

  objectBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-id');
      if (!id) return;
      
      if (selectedObjects.includes(id)) {
        selectedObjects = selectedObjects.filter(obj => obj !== id);
        btn.classList.remove('selected');
      } else {
        if (selectedObjects.length < 2) {
          selectedObjects.push(id);
          btn.classList.add('selected');
        } else {
          const oldBtn = document.querySelector(`.object-btn[data-id="${selectedObjects[1]}"]`);
          if (oldBtn) oldBtn.classList.remove('selected');
          selectedObjects[1] = id;
          btn.classList.add('selected');
        }
      }

      if (selectionCount) {
        selectionCount.textContent = `${selectedObjects.length} / 2 selected`;
      }
      if (simulateBtn) {
        simulateBtn.disabled = selectedObjects.length !== 2;
      }
    });
  });

  const sleep = (ms: number) => new Promise(r => setTimeout(r, ms));

  if (simulateBtn) {
    simulateBtn.addEventListener('click', async () => {
      if (selectedObjects.length !== 2) return;
      
      const sorted = [...selectedObjects].sort();
      const btn1 = document.querySelector(`.object-btn[data-id="${sorted[0]}"]`);
      const btn2 = document.querySelector(`.object-btn[data-id="${sorted[1]}"]`);
      const name1 = btn1 ? btn1.querySelector('.object-label')?.textContent : sorted[0];
      const name2 = btn2 ? btn2.querySelector('.object-label')?.textContent : sorted[1];
      
      if (selector && terminal && videoContainer && terminalLog) {
        selector.hidden = true;
        terminal.hidden = false;
        
        terminalLog.innerHTML = '';
        
        const sequence = [
          `> Initializing physics engine...`,
          `> Loading materials: [${name1}, ${name2}]...`,
          `> Estimating mass and friction coefficients...`,
          `> Generating TripoSR meshes...`,
          `> Running collision simulation...`
        ];

        for (const text of sequence) {
          const p = document.createElement('p');
          p.textContent = text;
          terminalLog.appendChild(p);
          await sleep(400);
        }
        
        await sleep(300);
        
        terminal.hidden = true;
        videoContainer.hidden = false;
      }

      if (videoSource) {
        videoSource.src = `/video/collision.mp4`; 
      }
      
      if (videoTitle) {
        videoTitle.textContent = `${name1} vs ${name2}`;
      }

      if (videoPlayer) {
        videoPlayer.load(); 
        videoPlayer.play().catch(e => console.log('Autoplay prevented:', e));
      }
    });
  }

  if (backBtn) {
    backBtn.addEventListener('click', () => {
      if (videoPlayer) videoPlayer.pause();
      if (videoContainer) videoContainer.hidden = true;
      if (selector) selector.hidden = false;
    });
  }
</script>

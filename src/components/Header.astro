---
const currentPath = Astro.url.pathname;

const links = [
  { href: "/", label: "Home" },
  { href: "/projects/", label: "Projects" },
  { href: "/about/", label: "About" },
  { href: "/resume", label: "Resume" },
];
---

<header class="site-header">
  <a class="brand" href="/" aria-label="Darren Wang home">
    <span class="brand-mark">DW</span>
    <span>Darren Wang</span>
  </a>
  <div class="header-actions">
    <nav aria-label="Primary navigation">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              currentPath === link.href || (link.href !== "/" && currentPath.startsWith(link.href))
                ? "active"
                : "",
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark mode" aria-pressed="false" title="Switch to dark mode">
      <svg class="theme-toggle-sun" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v3M12 19v3M4.93 4.93l2.12 2.12M16.95 16.95l2.12 2.12M2 12h3M19 12h3M4.93 19.07l2.12-2.12M16.95 7.05l2.12-2.12" />
      </svg>
      <svg class="theme-toggle-moon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20.5 14.7A8.2 8.2 0 0 1 9.3 3.5 8.2 8.2 0 1 0 20.5 14.7Z" />
      </svg>
    </button>
  </div>
</header>

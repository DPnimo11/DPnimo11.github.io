---
const jobData = {
  properties: {
    objectA: {
      mass: 500,
      friction: 0.8,
      bounciness: 0.1
    },
    objectB: {
      mass: 600,
      friction: 0.75,
      bounciness: 0.15
    }
  }
};
---

<section class="demo-panel collision-demo-panel" aria-labelledby="demo-title">
  <div class="panel-heading">
    <p class="eyebrow">Interactive Demo</p>
    <h2 id="demo-title">Pipeline: 2D to 3D Collision</h2>
  </div>

  <div class="pipeline-viewer">
    <div class="pipeline-tabs">
      <button class="tab-btn active" data-target="tab-input">01. Input</button>
      <button class="tab-btn" data-target="tab-estimate">02. Estimate</button>
      <button class="tab-btn" data-target="tab-generate">03. Generate</button>
      <button class="tab-btn" data-target="tab-render">04. Render</button>
    </div>

    <div class="tab-content active" id="tab-input">
      <div class="split-view">
        <div class="input-card">
          <img src="/collision-job/objectA/clean.png" alt="Labubu clean input" />
          <p>Object A (Labubu)</p>
        </div>
        <div class="input-card">
          <img src="/collision-job/objectB/clean.png" alt="Unicorn clean input" />
          <p>Object B (Unicorn)</p>
        </div>
      </div>
    </div>

    <div class="tab-content" id="tab-estimate">
      <div class="json-viewer">
        <pre><code>{`{
  "objectA": {
    "material": "Vinyl/Plastic",
    "mass_g": ${jobData.properties.objectA.mass},
    "friction": ${jobData.properties.objectA.friction},
    "bounciness": ${jobData.properties.objectA.bounciness}
  },
  "objectB": {
    "material": "Rubber/Foam",
    "mass_g": ${jobData.properties.objectB.mass},
    "friction": ${jobData.properties.objectB.friction},
    "bounciness": ${jobData.properties.objectB.bounciness}
  }
}`}</code></pre>
      </div>
    </div>

    <div class="tab-content" id="tab-generate">
      <div class="split-view mesh-view">
        <div class="model-container">
          <model-viewer src="/collision-job/labubu.glb" auto-rotate camera-controls shadow-intensity="1" orientation="0deg -90deg 0deg"></model-viewer>
          <p>TripoSR Mesh A</p>
        </div>
        <div class="model-container">
          <model-viewer src="/collision-job/unicorn.glb" auto-rotate camera-controls shadow-intensity="1" orientation="0deg -90deg 0deg"></model-viewer>
          <p>TripoSR Mesh B</p>
        </div>
      </div>
    </div>

    <div class="tab-content" id="tab-render">
      <div class="collision-video-frame">
        <video controls playsinline preload="metadata" poster="/img/collision.jpg">
          <source src="/collision-job/output_collision.mp4" type="video/mp4" />
          <a href="/collision-job/output_collision.mp4">Open the collision video</a>
        </video>
      </div>
    </div>
  </div>
</section>

<!-- Include model-viewer component script from Google -->
<script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.4.0/model-viewer.min.js"></script>

<script>
  const tabBtns = document.querySelectorAll('.tab-btn');
  const tabContents = document.querySelectorAll('.tab-content');

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      // Remove active from all
      tabBtns.forEach(b => b.classList.remove('active'));
      tabContents.forEach(c => c.classList.remove('active'));

      // Add active to clicked
      btn.classList.add('active');
      const targetId = btn.getAttribute('data-target');
      if (targetId) {
        const targetContent = document.getElementById(targetId);
        if (targetContent) targetContent.classList.add('active');
      }
    });
  });
</script>

---
import type { Project } from "../data/projects";
import AffinityDemo from "./demos/AffinityDemo.astro";
import AzureCriticalityDemo from "./demos/AzureCriticalityDemo.astro";
import ChartsDemo from "./demos/ChartsDemo.astro";
import ChessDemo from "./demos/ChessDemo.astro";
import CollisionDemo from "./demos/CollisionDemo.astro";
import DatabaseDemo from "./demos/DatabaseDemo.astro";
import HiringDemo from "./demos/HiringDemo.astro";
import LeetLoopDemo from "./demos/LeetLoopDemo.astro";
import PaintDemo from "./demos/PaintDemo.astro";
import PaperDemo from "./demos/PaperDemo.astro";
import SparkMapDemo from "./demos/SparkMapDemo.astro";
import StructuresDemo from "./demos/StructuresDemo.astro";
import TerminalDemo from "./demos/TerminalDemo.astro";
import TranslatorDemo from "./demos/TranslatorDemo.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const demoComponents = {
  affinity: AffinityDemo,
  "azure-criticality": AzureCriticalityDemo,
  charts: ChartsDemo,
  chess: ChessDemo,
  database: DatabaseDemo,
  hiring: HiringDemo,
  leetloop: LeetLoopDemo,
  map: SparkMapDemo,
  paint: PaintDemo,
  paper: PaperDemo,
  pipeline: CollisionDemo,
  structures: StructuresDemo,
  terminal: TerminalDemo,
  translator: TranslatorDemo,
};
const ActiveDemo = demoComponents[project.demo];
---

<ActiveDemo />
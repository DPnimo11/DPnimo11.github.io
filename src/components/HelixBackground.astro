---
// src/components/HelixBackground.astro
---
<div id="helix-container" aria-hidden="true"></div>

<script>
  import * as THREE from 'three';

  const container = document.getElementById('helix-container');
  if (container) {
    const scene = new THREE.Scene();
    const getSize = () => ({
      width: container.clientWidth || window.innerWidth,
      height: container.clientHeight || window.innerHeight,
    });
    const initialSize = getSize();
    
    const camera = new THREE.PerspectiveCamera(45, initialSize.width / initialSize.height, 0.1, 1000);
    camera.position.z = 40;
    
    const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
    renderer.setSize(initialSize.width, initialSize.height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    container.appendChild(renderer.domElement);

    const tiltGroup = new THREE.Group();
    const helixGroup = new THREE.Group();
    tiltGroup.add(helixGroup);
    
    const numPoints = 2400;
    const height = 180;
    const radius = 7.5; 
    const frequency = 0.3; 
    const snippets = [
        "struct pcb_t {", "pid_t pid;", "int status;", "void *stack;", 
        "struct pcb_t *next;", "};", "void schedule() {", "pcb_t *p = pop();", 
        "context_switch(p);", "}", "import torch", "import torch.nn as nn", 
        "class Model(nn.Module):", "def forward(self, x):", "return self.fc(x)"
    ];

    const getInkColor = () => getComputedStyle(document.documentElement).getPropertyValue('--ink').trim() || '#111613';

    const drawCodeTexture = (texture, color) => {
      const canvas = texture.image;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.fillStyle = 'rgba(255, 255, 255, 0)'; 
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.fillStyle = color;
      ctx.font = 'bold 48px monospace'; 
      ctx.textAlign = 'left';
      ctx.textBaseline = 'top';
      
      // Pack text tightly vertically and horizontally.
      for (let y = 0; y < canvas.height; y += 42) {
          let lineStr = "";
          for(let i=0; i<20; i++) {
              lineStr += snippets[Math.floor(Math.random() * snippets.length)] + " ";
          }
          const offsetX = -(Math.random() * 100);
          ctx.fillText(lineStr, offsetX, y);
      }

      texture.needsUpdate = true;
    };

    // Generate Points for Curves
    const points1 = [];
    const points2 = [];
    for (let i = 0; i < numPoints; i++) {
      const t = i / numPoints;
      const y = (t - 0.5) * height;
      
      const angle1 = t * height * frequency;
      const x1 = Math.cos(angle1) * radius;
      const z1 = Math.sin(angle1) * radius;
      points1.push(new THREE.Vector3(x1, y, z1));

      const angle2 = t * height * frequency + Math.PI; 
      const x2 = Math.cos(angle2) * radius;
      const z2 = Math.sin(angle2) * radius;
      points2.push(new THREE.Vector3(x2, y, z2));
    }
    const curve1 = new THREE.CatmullRomCurve3(points1);
    const curve2 = new THREE.CatmullRomCurve3(points2);

    // --- Strand 1: Wireframe Tube (Biology) ---
    const geometry1 = new THREE.TubeGeometry(curve1, 450, 0.55, 8, false);
    const wireframeGeo = new THREE.WireframeGeometry(geometry1);
    const lineMat = new THREE.LineBasicMaterial({ color: getInkColor(), transparent: true, opacity: 0.28, linewidth: 1 });
    const wireframeTube = new THREE.LineSegments(wireframeGeo, lineMat);
    helixGroup.add(wireframeTube);

    // --- Strand 2: Code Tube (CS) ---
    const createDenseCodeTexture = () => {
      const canvas = document.createElement('canvas');
      canvas.width = 1024;
      canvas.height = 1024; 
      const texture = new THREE.CanvasTexture(canvas);
      drawCodeTexture(texture, getInkColor());
      texture.wrapS = THREE.RepeatWrapping;
      texture.wrapT = THREE.RepeatWrapping;
      // Perfect aspect ratio mapping for lengthwise tube flow
      // Repeated 48 times to match the 3x increased height (180 vs 60)
      texture.repeat.set(48, 0.5); 
      texture.minFilter = THREE.LinearFilter;
      return texture;
    };

    const geometry2 = new THREE.TubeGeometry(curve2, 450, 0.55, 10, false);
    const codeTexture = createDenseCodeTexture();
    const material2 = new THREE.MeshBasicMaterial({ 
        map: codeTexture, 
        transparent: true, 
        opacity: 0.64,
        side: THREE.DoubleSide
    });
    const codeTube = new THREE.Mesh(geometry2, material2);
    helixGroup.add(codeTube);

    // --- Connecting Rungs (Half Bio, Half Code) ---
    // Clone the texture so we can map it to the short rungs independently
    const rungCodeTexture = codeTexture.clone();
    rungCodeTexture.needsUpdate = true;
    
    // Rung length is ~7.5, circumference is ~2.2.
    // Scaled up by 1.33x to compensate for the main font size increase (36px -> 48px)
    // so the rung text remains exactly the same physical size as before.
    rungCodeTexture.repeat.set(1.06, 0.31); 
    const rungCodeMat = new THREE.MeshBasicMaterial({ map: rungCodeTexture, transparent: true, opacity: 0.58 });

    const updateThemeColors = () => {
      const inkColor = getInkColor();
      lineMat.color.set(inkColor);
      drawCodeTexture(codeTexture, inkColor);
      rungCodeTexture.needsUpdate = true;
    };

    const themeObserver = new MutationObserver(updateThemeColors);
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    for (let i = 0; i < numPoints; i += 28) {
      const t = i / numPoints;
      
      // Calculate exact positions on the curves to guarantee perfect alignment
      const p1 = curve1.getPoint(t); 
      const p2 = curve2.getPoint(t);
      
      const distance = p1.distanceTo(p2);
      const midPoint = p1.clone().lerp(p2, 0.5);
      
      // Bio Half (Wireframe Cylinder)
      const bioGeo = new THREE.CylinderGeometry(0.25, 0.25, distance / 2, 6);
      const bioWireframeGeo = new THREE.WireframeGeometry(bioGeo);
      const bioMesh = new THREE.LineSegments(bioWireframeGeo, lineMat); // Reuse wireframe material
      
      bioMesh.position.copy(p1.clone().lerp(midPoint, 0.5));
      bioMesh.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), midPoint.clone().sub(p1).normalize());
      helixGroup.add(bioMesh);

      // Code Half (Static Code Tube)
      // TubeGeometry guarantees text flows flawlessly lengthwise
      const rungCurve = new THREE.LineCurve3(midPoint, p2);
      const codeGeo = new THREE.TubeGeometry(rungCurve, 2, 0.25, 8, false);
      const codeMesh = new THREE.Mesh(codeGeo, rungCodeMat);
      helixGroup.add(codeMesh);
    }

    // Position and tilt the parent group
    tiltGroup.rotation.z = -Math.PI / 4; 
    
    scene.add(tiltGroup);

    // Animation Loop
    const animate = function () {
      requestAnimationFrame(animate);
      helixGroup.rotation.y += 0.0025; // Pure rotation around the internal Y axis
      
      // Scroll main tube lengthwise
      codeTexture.offset.x -= 0.005;
      
      // We intentionally do NOT scroll rungCodeTexture here, 
      // so it remains physically locked to the rotating helix structure.
      
      renderer.render(scene, camera);
    };

    animate();

    const updateLayout = () => {
      const { width, height } = getSize();
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height);
      
      const isMobile = width < 560;
      const isNarrow = width < 760;
      tiltGroup.position.x = isMobile ? 0 : isNarrow ? 1.5 : 4;
      tiltGroup.position.y = isMobile ? -7 : -2.5;
      const scale = isMobile ? 0.78 : isNarrow ? 0.92 : 1.08;
      tiltGroup.scale.setScalar(scale);
    };

    const resizeObserver = new ResizeObserver(updateLayout);
    resizeObserver.observe(container);
    window.addEventListener('resize', updateLayout);
    
    // Initial size
    updateLayout();
  }
</script>

<style>
  #helix-container {
    position: absolute;
    inset: -5% -8% -8% -2%;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent 0, black 16%, black 100%);
    opacity: 0.92;
  }

  #helix-container canvas {
    display: block;
  }
</style>

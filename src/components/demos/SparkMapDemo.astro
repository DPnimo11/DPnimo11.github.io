---
const mapboxToken = import.meta.env.PUBLIC_MAPBOX_TOKEN ?? "";
const sparkMap = {
  center: { lng: -75.1946, lat: 39.9554 },
  zoom: 13.86,
  width: 1080,
  height: 720,
  style: "streets-v12",
};
const sparkStaticMapUrl = mapboxToken
  ? `https://api.mapbox.com/styles/v1/mapbox/${sparkMap.style}/static/${sparkMap.center.lng},${sparkMap.center.lat},${sparkMap.zoom},0/${sparkMap.width}x${sparkMap.height}@2x?access_token=${mapboxToken}`
  : "";

const projectSparkPoint = (lng: number, lat: number) => {
  const toRadians = (value: number) => (value * Math.PI) / 180;
  const worldSize = 512 * 2 ** sparkMap.zoom;
  const mercatorX = (value: number) => ((value + 180) / 360) * worldSize;
  const mercatorY = (value: number) => {
    const sin = Math.sin(toRadians(value));
    return (0.5 - Math.log((1 + sin) / (1 - sin)) / (4 * Math.PI)) * worldSize;
  };

  const centerX = mercatorX(sparkMap.center.lng);
  const centerY = mercatorY(sparkMap.center.lat);
  const x = sparkMap.width / 2 + mercatorX(lng) - centerX;
  const y = sparkMap.height / 2 + mercatorY(lat) - centerY;

  return {
    x: (x / sparkMap.width) * 100,
    y: (y / sparkMap.height) * 100,
  };
};

const sparkPosts = [

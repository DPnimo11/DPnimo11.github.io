---
import ProjectCard from "../../components/ProjectCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects } from "../../data/projects";
---

<BaseLayout title="Projects | Darren Wang" description="Curated software, research, systems, and ML projects by Darren Wang.">
  <section class="page-title">
    <p class="eyebrow">Project index</p>
    <h1>Projects</h1>
    <p>
      Recent public work, with live interaction where it is stable and short case studies where the project depends on keys, backends, or local compute.
    </p>
  </section>

  <section class="project-grid wide">
    {projects.map((project) => <ProjectCard project={project} />)}
  </section>
</BaseLayout>

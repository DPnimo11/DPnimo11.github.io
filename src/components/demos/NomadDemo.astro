<section class="demo-panel nomad-panel" aria-labelledby="nomad-demo-title">
  <div class="panel-heading">
    <p class="eyebrow">Dashboard preview</p>
    <h2 id="nomad-demo-title">Stop-detection algorithms in motion</h2>
  </div>
  <div class="nomad-preview-frame">
    <video autoplay muted loop playsinline controls preload="metadata" data-nomad-preview aria-label="Recorded preview of the NOMAD stop-detection dashboard">
      <source src="/video/nomad-dashboard-preview.mp4" type="video/mp4" />
      Your browser does not support embedded MP4 video.
    </video>
  </div>
  <p class="nomad-preview-caption">
    A recorded run of the public dashboard, which visualizes synthetic mobility trajectories and compares stop-detection output.
  </p>
</section>

<script>
  const preview = document.querySelector("[data-nomad-preview]");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  const syncPlaybackPreference = () => {
    if (!(preview instanceof HTMLVideoElement)) return;

    if (reducedMotion.matches) {
      preview.removeAttribute("autoplay");
      preview.pause();
      return;
    }

    preview.setAttribute("autoplay", "");
    void preview.play().catch(() => {});
  };

  syncPlaybackPreference();
  reducedMotion.addEventListener("change", syncPlaybackPreference);
</script>

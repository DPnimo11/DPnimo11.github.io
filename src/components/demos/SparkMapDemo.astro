].map((post) => {
  const position = projectSparkPoint(post.lng, post.lat);
  return {
    ...post,
    markerStyle: `--marker-x: ${position.x.toFixed(2)}%; --marker-y: ${position.y.toFixed(2)}%;`,
  };
});
---

    <section class="demo-panel map-panel" aria-labelledby="demo-title">
      <div class="panel-heading">
        <p class="eyebrow">Product surface</p>
        <h2 id="demo-title">Location posts and network filters</h2>
      </div>
      <div class={`map-sketch spark-map-shell${sparkStaticMapUrl ? "" : " map-fallback"}`} role="group" aria-label="Static map of University City, Philadelphia with sample Spark posts" data-spark-static-map>
        {sparkStaticMapUrl && (
          <img class="spark-map-image" src={sparkStaticMapUrl} alt="" loading="eager" fetchpriority="high" data-spark-static-map-image />
        )}
        <div class="spark-map-markers" aria-label="Sample Spark posts">
          {sparkPosts.map((post) => (
            <button
              class={`spark-map-marker spark-marker-${post.kind}`}
              type="button"
              style={post.markerStyle}
              data-spark-post-marker
              data-post-id={post.id}
              data-post-location={post.location}
              data-post-message={post.message}
              data-post-kind={post.kind}
              data-post-photo={post.photo ?? ""}
              data-post-stamp-rotate={post.stamp.rotate}
              data-post-stamp-x={post.stamp.x}
              data-post-stamp-y={post.stamp.y}
              data-post-postmark-rotate={post.postmark.rotate}
              data-post-postmark-x={post.postmark.x}
              data-post-postmark-y={post.postmark.y}
              aria-label={`Open post at ${post.location}`}
            >
              <span class="spark-marker-pin" aria-hidden="true"><span></span></span>
            </button>
          ))}
        </div>
        <article class="spark-post-card" data-spark-post-card hidden aria-live="polite">
          <button class="spark-post-close" type="button" data-spark-post-close aria-label="Close post preview"></button>
          <figure class="spark-post-photo" data-spark-post-photo-wrap hidden>
            <img alt="" loading="lazy" data-spark-post-photo />
          </figure>
          <div class="spark-post-body">
            <div class="spark-post-top">
              <p class="spark-post-location" data-spark-post-location></p>
              <img class="spark-post-stamp" src="/img/stamp.png" alt="" loading="lazy" aria-hidden="true" />
              <img class="spark-post-postmark" src="/img/postmark.png" alt="" loading="lazy" aria-hidden="true" />
            </div>
            <p class="spark-post-message" data-spark-post-message></p>
          </div>
        </article>
        <div class="spark-map-fallback" data-spark-static-map-fallback>
          <span>{sparkStaticMapUrl ? "Map preview unavailable" : "Set PUBLIC_MAPBOX_TOKEN to load the map preview"}</span>
        </div>
      </div>
    </section>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-spark-static-map]");
    if (!root) return;

    const image = root.querySelector("[data-spark-static-map-image]");
    const fallback = root.querySelector("[data-spark-static-map-fallback]");
    const markers = Array.from(root.querySelectorAll("[data-spark-post-marker]"));
    const postCard = root.querySelector("[data-spark-post-card]");
    const postLocation = root.querySelector("[data-spark-post-location]");
    const postMessage = root.querySelector("[data-spark-post-message]");
    const postPhotoWrap = root.querySelector("[data-spark-post-photo-wrap]");
    const postPhoto = root.querySelector("[data-spark-post-photo]");
    const closeButton = root.querySelector("[data-spark-post-close]");
    let activeMarker = null;
    let photoRequestId = 0;

    const showFallback = (message) => {
      if (fallback && message) fallback.querySelector("span").textContent = message;
      root.classList.add("map-fallback");
    };

    const closePost = () => {
      postCard?.setAttribute("hidden", "");
      postCard?.removeAttribute("style");
      postCard?.classList.remove("visible", "postcard-photo", "postcard-text");
      root.classList.remove("post-open");
      markers.forEach((marker) => marker.classList.remove("active"));
      activeMarker = null;
    };

    const clearPhoto = () => {
      if (!postPhoto || !postPhotoWrap) return;
      postPhoto.onload = null;
      postPhoto.onerror = null;
      postPhoto.removeAttribute("src");
      postPhoto.alt = "";
      postPhotoWrap.setAttribute("hidden", "");
    };

    const positionPostCard = (marker) => {
      if (!postCard || !marker) return;

      const edgeGap = 14;
      const markerClearance = 25;
      const leftShadowOffset = 20;
      const rootRect = root.getBoundingClientRect();
      const markerRect = marker.getBoundingClientRect();
      const cardRect = postCard.getBoundingClientRect();
      const markerX = markerRect.left - rootRect.left + markerRect.width / 2;
      const markerY = markerRect.top - rootRect.top + markerRect.width / 2;
      const maxLeft = Math.max(edgeGap, rootRect.width - cardRect.width - edgeGap);
      const maxTop = Math.max(edgeGap, rootRect.height - cardRect.height - edgeGap);
      const clamp = (value, min, max) => Math.max(min, Math.min(value, max));
      const safeBox = {
        left: markerX - markerClearance,
        right: markerX + markerClearance,
        top: markerY - markerClearance,
        bottom: markerY + markerClearance,
      };
      const candidates = [
        { left: markerX + markerClearance, top: markerY - cardRect.height / 2 },
        { left: markerX - cardRect.width - markerClearance - leftShadowOffset, top: markerY - cardRect.height / 2 },
        { left: markerX - cardRect.width / 2, top: markerY + markerClearance },
        { left: markerX - cardRect.width / 2, top: markerY - cardRect.height - markerClearance },
      ];
      const choices = candidates.map((candidate, index) => {
        const left = clamp(candidate.left, edgeGap, maxLeft);
        const top = clamp(candidate.top, edgeGap, maxTop);
        const overlapX = Math.max(0, Math.min(left + cardRect.width, safeBox.right) - Math.max(left, safeBox.left));
        const overlapY = Math.max(0, Math.min(top + cardRect.height, safeBox.bottom) - Math.max(top, safeBox.top));
        const overlapPenalty = overlapX * overlapY;
        const clampPenalty = Math.abs(left - candidate.left) + Math.abs(top - candidate.top);

        return {
          left,
          top,
          score: overlapPenalty * 1000 + clampPenalty + index,
        };
      });
      const best = choices.sort((a, b) => a.score - b.score)[0];
      const originX = clamp(markerX - best.left, 0, cardRect.width);
      const originY = clamp(markerY - best.top, 0, cardRect.height);

      postCard.style.left = `${best.left}px`;
      postCard.style.top = `${best.top}px`;
      postCard.style.setProperty("--post-origin-x", `${originX}px`);
      postCard.style.setProperty("--post-origin-y", `${originY}px`);
    };

    const loadPostPhoto = (src, location) => {
      const requestId = ++photoRequestId;
      if (!postPhoto || !postPhotoWrap || !src) {
        clearPhoto();
        return;
      }

      postPhoto.onload = () => {
        if (requestId !== photoRequestId) return;
        postPhotoWrap.removeAttribute("hidden");
        positionPostCard(activeMarker);
      };
      postPhoto.onerror = () => {
        if (requestId === photoRequestId) clearPhoto();
      };
      postPhoto.alt = `${location} post photo`;
      postPhoto.src = src;
      postPhotoWrap.removeAttribute("hidden");
      positionPostCard(activeMarker);

      if (postPhoto.complete && postPhoto.naturalWidth > 0) {
        positionPostCard(activeMarker);
      }
    };

    const openPost = (marker) => {
      if (!postCard || !postLocation || !postMessage) return;
      const location = marker.dataset.postLocation || "";
      const message = marker.dataset.postMessage || "";
      const kind = marker.dataset.postKind || "text";
      const photo = marker.dataset.postPhoto || "";
      const stampRotate = marker.dataset.postStampRotate || "0deg";
      const stampX = marker.dataset.postStampX || "0px";
      const stampY = marker.dataset.postStampY || "0px";
      const postmarkRotate = marker.dataset.postPostmarkRotate || "0deg";
      const postmarkX = marker.dataset.postPostmarkX || "0px";
      const postmarkY = marker.dataset.postPostmarkY || "0px";

      activeMarker = marker;
      root.classList.add("post-open");
      markers.forEach((item) => item.classList.toggle("active", item === marker));
      postLocation.textContent = location;
      postMessage.textContent = message;
      postCard.classList.remove("visible", "postcard-photo", "postcard-text");
      postCard.classList.add(kind === "photo" ? "postcard-photo" : "postcard-text");
      postCard.style.setProperty("--stamp-rotate", stampRotate);
      postCard.style.setProperty("--stamp-x", stampX);
      postCard.style.setProperty("--stamp-y", stampY);
      postCard.style.setProperty("--postmark-rotate", postmarkRotate);
      postCard.style.setProperty("--postmark-x", postmarkX);
      postCard.style.setProperty("--postmark-y", postmarkY);
      postCard.removeAttribute("hidden");
      loadPostPhoto(photo, location);
      positionPostCard(marker);
      window.requestAnimationFrame(() => postCard.classList.add("visible"));
    };

    if (!image) return;

    image.addEventListener("load", () => root.classList.remove("map-fallback"), { once: true });
    image.addEventListener("error", () => showFallback("Map preview unavailable"), { once: true });

    if (image.complete && image.naturalWidth === 0) showFallback("Map preview unavailable");

    window.setTimeout(() => {
      if (!image.complete || image.naturalWidth === 0) showFallback("Map preview unavailable");
    }, 8000);

    markers.forEach((marker) => {
      marker.addEventListener("click", () => openPost(marker));
    });
    closeButton?.addEventListener("click", closePost);
    window.addEventListener("resize", () => positionPostCard(activeMarker));
    root.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closePost();
    });
  })();
</script>

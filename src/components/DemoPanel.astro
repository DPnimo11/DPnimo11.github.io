    const parseSquare = (square) => ({ fileIndex: files.indexOf(square[0]), rank: Number(square.slice(1)) });
    const currentStep = () => puzzles[activePuzzle].line[stepIndex];
    const userMoveCount = (puzzle) => puzzle.line.filter((step) => step.actor === "user").length;

    const isEnemyPiece = (piece, color) => piece && pieceColor(piece) !== color;
    const isCapturable = (piece, color) => isEnemyPiece(piece, color) && piece.toLowerCase() !== "k";
    const inBounds = (fileIndex, rank) => fileIndex >= 0 && fileIndex < 8 && rank >= 1 && rank <= 8;

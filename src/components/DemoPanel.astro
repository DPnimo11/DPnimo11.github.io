---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

{
  project.demo === "leetloop" && (
    <section class="demo-panel demo-leetloop" aria-labelledby="demo-title">
      <div class="panel-heading">
        <p class="eyebrow">Interactive artifact</p>
        <h2 id="demo-title">A tiny review queue</h2>
      </div>
      <div class="leetloop-demo" data-leetloop-demo>
        <div class="queue-header">
          <span>Today</span>
          <strong data-due-count>3 due</strong>
        </div>
        <div class="review-list" data-review-list></div>
        <div class="review-actions" aria-label="Review actions">
          <button type="button" data-review-action="again">Again</button>
          <button type="button" data-review-action="solved">Solved</button>
        </div>
      </div>
    </section>
  )
}

{
  project.demo === "terminal" && (
    <section class="demo-panel terminal-panel" aria-labelledby="demo-title">
      <div class="panel-heading">
        <p class="eyebrow">Transcript demo</p>
        <h2 id="demo-title">PennOS shell sketch</h2>
      </div>
      <pre><code>pennfat# mkfs disk.fs 1024 1
pennfat# mount disk.fs
pennfat# touch notes.txt
pennfat# chmod +rw notes.txt

$ ./pennos disk.fs log/scheduler.log
pennos&gt; nice 1 sleep 8 &
[job 1] pid 4 running
pennos&gt; jobs
1  running  sleep 8
pennos&gt; fg 1</code></pre>
    </section>
  )
}

{
  project.demo === "pipeline" && (
    <section class="demo-panel pipeline-panel" aria-labelledby="demo-title">
      <div class="panel-heading">
        <p class="eyebrow">Video demo</p>
        <h2 id="demo-title">Rendered collision result</h2>
      </div>
      <div class="collision-video-frame">
        <video controls playsinline preload="metadata" poster="/img/collision.jpg">
          <source src="/video/collision.mp4" type="video/mp4" />
          <a href="/video/collision.mp4">Open the collision video</a>
        </video>
      </div>
      <ol class="pipeline-steps">
        <li><span>01</span><strong>Upload</strong><p>Two source images enter a browser UI.</p></li>
        <li><span>02</span><strong>Estimate</strong><p>Gemini proposes editable physical properties.</p></li>
        <li><span>03</span><strong>Generate</strong><p>TripoSR creates meshes for the objects.</p></li>
        <li><span>04</span><strong>Render</strong><p>Blender runs the collision and streams the result.</p></li>
      </ol>
    </section>
  )
}

{
  project.demo === "map" && (
    <section class="demo-panel map-panel" aria-labelledby="demo-title">
      <div class="panel-heading">
        <p class="eyebrow">Product surface</p>
        <h2 id="demo-title">Location posts and network filters</h2>
      </div>
      <div class="map-sketch" aria-hidden="true">
        <span class="marker m1"></span>
        <span class="marker m2"></span>
        <span class="marker m3"></span>
        <span class="map-route"></span>
      </div>
    </section>
  )
}

{
  project.demo === "translator" && (
    <section class="demo-panel translator-panel" aria-labelledby="demo-title">
      <div class="panel-heading">
        <p class="eyebrow">Pipeline view</p>
        <h2 id="demo-title">Browser page to translated overlay</h2>
      </div>
      <ol class="pipeline-steps">
        <li><span>01</span><strong>Detect</strong><p>Extension finds large manga images on the active tab.</p></li>
        <li><span>02</span><strong>Read</strong><p>Backend runs OCR and groups nearby text regions.</p></li>
        <li><span>03</span><strong>Translate</strong><p>Cerebras or Gemini handles batched text translation.</p></li>
        <li><span>04</span><strong>Overlay</strong><p>English text boxes render back over the source page.</p></li>
      </ol>
    </section>
  )
}

{
  project.demo === "hiring" && (
    <section class="demo-panel hiring-panel" aria-labelledby="demo-title">
      <div class="panel-heading">
        <p class="eyebrow">Product flow</p>
        <h2 id="demo-title">Resume intake to candidate outreach</h2>
      </div>
      <ol class="pipeline-steps">
        <li><span>01</span><strong>Define</strong><p>Set role requirements, tech stack, and screening preferences.</p></li>
        <li><span>02</span><strong>Compress</strong><p>Use The Token Company to reduce resume input before AI parsing.</p></li>
        <li><span>03</span><strong>Swipe</strong><p>Review candidate cards with interested, pass, star, and undo states.</p></li>
        <li><span>04</span><strong>Email</strong><p>Generate customized candidate emails from profile-specific details.</p></li>
      </ol>
    </section>
  )
}

{
  project.demo === "structures" && (
    <section class="demo-panel structure-panel" aria-labelledby="demo-title">
      <div class="panel-heading">
        <p class="eyebrow">Aligned structures</p>
        <h2 id="demo-title">Predicted peptide vs X-ray pose</h2>
      </div>
      <div class="structure-demo" data-pepdock-viewer>
        <div class="structure-case-tabs" role="tablist" aria-label="PepDock structure cases">
          <button class="active" type="button" data-structure-case="6n3e">6N3E</button>
          <button type="button" data-structure-case="8rop">8ROP</button>
          <button type="button" data-structure-case="4c5a">4C5A</button>
          <button type="button" data-structure-case="5v2p-i15k">5V2P I15K</button>
        </div>
        <div class="structure-viewer-grid">
          <div class="protein-viewer" data-protein-viewer aria-label="Aligned molecular structure viewer">
            <span class="viewer-status" data-viewer-status>Loading molecular viewer...</span>
          </div>
          <aside class="structure-sidebar" aria-live="polite">
            <p class="eyebrow" data-structure-kind>Original / high accuracy</p>
            <h3 data-structure-title>6N3E</h3>
            <p data-structure-note>AF3 prediction nearly overlaps the X-ray peptide pose.</p>
            <dl class="structure-metrics">
              <div>
                <dt>DockQ</dt>
                <dd data-structure-dockq>0.989</dd>
              </div>
              <div>
                <dt>RMSD</dt>
                <dd data-structure-rmsd>0.63 A</dd>
              </div>
            </dl>
            <div class="structure-controls" aria-label="Viewer controls">
              <button class="active" type="button" data-structure-style="cartoon">Cartoon</button>
              <button type="button" data-structure-style="sticks">Sticks</button>
              <button type="button" data-structure-style="surface">Surface</button>
              <button type="button" data-structure-action="focus">Peptides</button>
              <button type="button" data-structure-action="reset">Reset</button>
            </div>
            <div class="structure-legend" aria-label="Structure color legend">
              <span><i class="legend-xray-rec"></i>X-ray receptor</span>
              <span><i class="legend-pred-rec"></i>Predicted receptor</span>
              <span><i class="legend-xray-pep"></i>X-ray peptide</span>
              <span><i class="legend-pred-pep"></i>Predicted peptide</span>
            </div>
          </aside>
        </div>
      </div>
    </section>
  )
}

{
  project.demo === "paint" && (
    <section class="demo-panel paint-panel" aria-labelledby="demo-title">
      <div class="panel-heading">
        <p class="eyebrow">Interactive artifact</p>
        <h2 id="demo-title">Pixel sketch grid</h2>
      </div>
      <div class="paint-demo" data-paint-demo>
        <div class="paint-toolbar" aria-label="Paint controls">
          <div class="paint-tool-group" aria-label="Brush modes">
            <button class="active" type="button" data-paint-mode="black" aria-pressed="true">Black</button>
            <button type="button" data-paint-mode="rainbow" aria-pressed="false">Rainbow</button>
            <button type="button" data-paint-mode="eraser" aria-pressed="false">Eraser</button>
          </div>
          <label class="paint-size-control">
            <span>Size</span>
            <input type="range" min="12" max="36" value="20" step="2" data-paint-size />
            <strong data-paint-size-label>20</strong>
          </label>
          <button class="paint-clear" type="button" data-paint-clear>Clear</button>
        </div>
        <div class="paint-board" data-paint-board aria-label="Drawing grid"></div>
      </div>
    </section>
  )
}

{
  project.demo === "chess" && (
    <section class="demo-panel chess-panel" aria-labelledby="demo-title">
      <div class="panel-heading">
        <p class="eyebrow">Interactive artifact</p>
        <h2 id="demo-title">Puzzles</h2>
      </div>
      <div class="chess-demo" data-chess-demo>
        <div class="chess-level-tabs" role="tablist" aria-label="Chess puzzle difficulty">
          <button class="active" type="button" data-chess-puzzle="easy">Easy</button>
          <button type="button" data-chess-puzzle="medium">Medium</button>
          <button type="button" data-chess-puzzle="hard">Hard</button>
        </div>
        <div class="chess-trainer-grid">
          <div class="chess-board-frame">
            <div class="chess-rank-labels" aria-hidden="true">
              <span>8</span>
              <span>7</span>
              <span>6</span>
              <span>5</span>
              <span>4</span>
              <span>3</span>
              <span>2</span>
              <span>1</span>
            </div>
            <div class="chess-board" data-chess-board aria-label="Interactive chess tactics board"></div>
            <div class="chess-file-labels" aria-hidden="true">
              <span>a</span>
              <span>b</span>
              <span>c</span>
              <span>d</span>
              <span>e</span>
              <span>f</span>
              <span>g</span>
              <span>h</span>
            </div>
          </div>
          <aside class="chess-logic" aria-live="polite">
            <p class="eyebrow" data-chess-difficulty>Easy / mate in one</p>
            <h3 data-chess-title>Corner net</h3>
            <p data-chess-goal>White to move. Find the mate.</p>
            <dl class="chess-progress">
              <div>
                <dt>Progress</dt>
                <dd data-chess-progress>0 / 1</dd>
              </div>
              <div>
                <dt>Last move</dt>
                <dd data-chess-last>None</dd>
              </div>
            </dl>
            <p class="chess-status" data-chess-status>Select a white piece.</p>
            <button class="chess-reset" type="button" data-chess-reset>Reset puzzle</button>
          </aside>
        </div>
      </div>
    </section>
  )
}

{
  project.demo === "charts" && (
    <section class="demo-panel chart-panel" aria-labelledby="demo-title">
      <div class="panel-heading">
        <p class="eyebrow">Analysis surface</p>
        <h2 id="demo-title">Modeling artifacts</h2>
      </div>
      <div class="bar-chart" aria-hidden="true">
        <span style="--h: 42%"></span>
        <span style="--h: 68%"></span>
        <span style="--h: 55%"></span>
        <span style="--h: 81%"></span>
        <span style="--h: 47%"></span>
      </div>
    </section>
  )
}

{
  project.demo === "azure-criticality" && (
    <section class="demo-panel azure-panel" aria-labelledby="demo-title">
      <div class="panel-heading">
        <p class="eyebrow">Interactive ML demo</p>
        <h2 id="demo-title">Azure Criticality Console</h2>
      </div>
      <div class="azure-demo" data-azure-criticality-demo>
        <ol class="azure-pipeline-strip" aria-label="Request-time prediction pipeline">
          <li><span>01</span><strong>Raw request</strong><p>Tenant, VM shape, cores, memory, region, and request time.</p></li>
          <li><span>02</span><strong>Request features</strong><p>Capacity-heavy fields are frozen at provisioning time.</p></li>
          <li><span>03</span><strong>Tenant window</strong><p>Historical behavior summarizes the prior fleet only.</p></li>
          <li><span>04</span><strong>Time split</strong><p>Training and validation stay chronological.</p></li>
          <li><span>05</span><strong>Criticality label</strong><p>Future behavior labels offline evaluation, not live inputs.</p></li>
        </ol>

        <div class="azure-console-grid">
          <aside class="azure-case-list" aria-label="VM request examples">
            <button class="active" type="button" data-azure-case="baseline" aria-pressed="true">
              <strong>Baseline</strong>
              <span>Steady tenant / medium VM</span>
            </button>
            <button type="button" data-azure-case="spiky" aria-pressed="false">
              <strong>CPU-spiky tenant</strong>
              <span>Burst-heavy recent history</span>
            </button>
            <button type="button" data-azure-case="large" aria-pressed="false">
              <strong>Large request</strong>
              <span>Many cores in a loaded region</span>
            </button>
            <button type="button" data-azure-case="lowHistory" aria-pressed="false">
              <strong>Low-history tenant</strong>
              <span>Sparse fleet observations</span>
            </button>
          </aside>

          <section class="azure-score-card" aria-live="polite">
            <div class="azure-score-top">
              <div>
                <span class="azure-score-label" data-azure-case-kind>Baseline tenant</span>
                <h3 data-azure-case-title>Medium request with stable history</h3>
              </div>
              <strong data-azure-score>36%</strong>
            </div>
            <div class="azure-gauge" aria-hidden="true">
              <span data-azure-gauge></span>
              <i data-azure-threshold-marker></i>
            </div>
            <p data-azure-case-note>
              Looks like ordinary provisioning: modest footprint, normal CPU history, and a familiar tenant profile.
            </p>
            <label class="azure-threshold-control">
              <span>Decision threshold <strong data-azure-threshold>55%</strong></span>
              <input type="range" min="20" max="85" step="5" value="55" data-azure-threshold-input />
            </label>
            <div class="azure-decision" data-azure-decision>Route to standard provisioning queue</div>
          </section>

          <aside class="azure-metrics-card">
            <dl class="azure-confusion" aria-label="Confusion matrix at selected threshold">
              <div><dt>TP</dt><dd data-azure-tp>0</dd></div>
              <div><dt>FP</dt><dd data-azure-fp>0</dd></div>
              <div><dt>FN</dt><dd data-azure-fn>0</dd></div>
              <div><dt>TN</dt><dd data-azure-tn>0</dd></div>
            </dl>
            <dl class="azure-pr-metrics">
              <div><dt>Precision</dt><dd data-azure-precision>0%</dd></div>
              <div><dt>Recall</dt><dd data-azure-recall>0%</dd></div>
              <div><dt>F1</dt><dd data-azure-f1>0%</dd></div>
              <div><dt>Review rate</dt><dd data-azure-review-rate>0%</dd></div>
            </dl>
          </aside>
        </div>

        <section class="azure-signals" aria-label="Top model signals">
          <div class="azure-signals-heading">
            <span>Top signals</span>
            <strong data-azure-signal-summary>Representative feature contributions</strong>
          </div>
          <div class="azure-signal-list" data-azure-signals></div>
        </section>
      </div>
    </section>
  )
}

{
  project.demo === "paper" && (
    <section class="demo-panel paper-panel" aria-labelledby="demo-title">
      <div class="panel-heading">
        <p class="eyebrow">Research artifact</p>
        <h2 id="demo-title">Docking and reranking loop</h2>
      </div>
      <div class="paper-figure">
        <span>AlphaFold structures</span>
        <span>ZDOCK candidates</span>
        <span>ANI-2x refinement</span>
        <span>Pose ranking</span>
      </div>
    </section>
  )
}

{
  project.demo === "affinity" && (
    <section class="demo-panel affinity-panel" aria-labelledby="demo-title">
      <div class="panel-heading">
        <p class="eyebrow">Feature model</p>
        <h2 id="demo-title">Embedding benchmark frame</h2>
      </div>
      <div class="matrix-figure" aria-hidden="true">
        {Array.from({ length: 64 }).map((_, index) => <span style={`--v: ${(index * 19) % 100}%`}></span>)}
      </div>
    </section>
  )
}

<script is:inline>
  (() => {
    const structureRoot = document.querySelector("[data-pepdock-viewer]");
    if (structureRoot) {
      const cases = {
        "6n3e": {
          title: "6N3E",
          kind: "Original / high accuracy",
          dockq: "0.989",
          rmsd: "0.63 A",
          note: "AF3 prediction nearly overlaps the X-ray peptide pose.",
          base: "/structures/pepdock/6n3e/",
        },
        "8rop": {
          title: "8ROP",
          kind: "Original / high accuracy",
          dockq: "0.985",
          rmsd: "0.34 A",
          note: "A second clean original target with tight receptor-frame agreement.",
          base: "/structures/pepdock/8rop/",
        },
        "4c5a": {
          title: "4C5A",
          kind: "Original / miss",
          dockq: "0.014",
          rmsd: "48.44 A",
          note: "The predicted peptide lands far from the X-ray binding pose.",
          base: "/structures/pepdock/4c5a/",
        },
        "5v2p-i15k": {
          title: "5V2P I15K",
          kind: "Single mutation collapse",
          dockq: "0.010",
          rmsd: "53.64 A",
          note: "One semi-conservative Ile15 to Lys substitution, Grantham 102, drops DockQ from 0.970 to 0.010.",
          base: "/structures/pepdock/5v2p-i15k/",
        },
      };

      const viewerNode = structureRoot.querySelector("[data-protein-viewer]");
      const statusNode = structureRoot.querySelector("[data-viewer-status]");
      const titleNode = structureRoot.querySelector("[data-structure-title]");
      const kindNode = structureRoot.querySelector("[data-structure-kind]");
      const noteNode = structureRoot.querySelector("[data-structure-note]");
      const dockqNode = structureRoot.querySelector("[data-structure-dockq]");
      const rmsdNode = structureRoot.querySelector("[data-structure-rmsd]");
      const caseButtons = structureRoot.querySelectorAll("[data-structure-case]");
      const styleButtons = structureRoot.querySelectorAll("[data-structure-style]");
      const actionButtons = structureRoot.querySelectorAll("[data-structure-action]");
      const viewerBackground = "#9aa6a3";
      const colors = {
        xrayReceptor: 0xffd34d,
        predictedReceptor: 0x1a7cff,
        xrayPeptide: 0x19a45b,
        predictedPeptide: 0xd4311f,
      };
      let viewer;
      let activeStyle = "cartoon";
      let activeCase = "6n3e";
      let models = [];

      const setStatus = (message) => {
        if (!statusNode) return;
        statusNode.textContent = message;
        statusNode.hidden = !message;
      };

      const load3Dmol = () =>
        new Promise((resolve, reject) => {
          if (window.$3Dmol) {
            resolve(window.$3Dmol);
            return;
          }

          const existing = document.querySelector("script[data-structure-lib]");
          if (existing) {
            existing.addEventListener("load", () => resolve(window.$3Dmol));
            existing.addEventListener("error", reject);
            return;
          }

          const script = document.createElement("script");
          script.src = "https://3Dmol.org/build/3Dmol-min.js";
          script.async = true;
          script.dataset.structureLib = "true";
          script.addEventListener("load", () => resolve(window.$3Dmol));
          script.addEventListener("error", reject);
          document.head.appendChild(script);
        });

      const loadPdb = async (url) => {
        const response = await fetch(url);
        if (!response.ok) throw new Error(`Could not load ${url}`);
        return response.text();
      };

      const updateCopy = (id) => {
        const item = cases[id];
        if (!item) return;
        if (titleNode) titleNode.textContent = item.title;
        if (kindNode) kindNode.textContent = item.kind;
        if (noteNode) noteNode.textContent = item.note;
        if (dockqNode) dockqNode.textContent = item.dockq;
        if (rmsdNode) rmsdNode.textContent = item.rmsd;

        caseButtons.forEach((button) => {
          const isActive = button.dataset.structureCase === id;
          button.classList.toggle("active", isActive);
          button.setAttribute("aria-selected", String(isActive));
        });
      };

      const styleModels = () => {
        if (!viewer || models.length !== 4) return;
        const [xrayReceptor, predictedReceptor, xrayPeptide, predictedPeptide] = models;
        viewer.removeAllSurfaces();
        models.forEach((model) => model.setStyle({}, {}));

        if (activeStyle === "surface") {
          xrayReceptor.setStyle({}, {
            cartoon: { color: colors.xrayReceptor, opacity: 0.25 },
            line: { color: colors.xrayReceptor, linewidth: 1 },
          });
          predictedReceptor.setStyle({}, {
            cartoon: { color: colors.predictedReceptor, opacity: 0.2 },
            line: { color: colors.predictedReceptor, linewidth: 1 },
          });
          xrayPeptide.setStyle({}, { stick: { color: colors.xrayPeptide, radius: 0.24 } });
          predictedPeptide.setStyle({}, { stick: { color: colors.predictedPeptide, radius: 0.24 } });
          viewer.addSurface(window.$3Dmol.SurfaceType.VDW, { color: colors.xrayReceptor, opacity: 0.75 }, { model: 0 });
          viewer.addSurface(window.$3Dmol.SurfaceType.VDW, { color: colors.predictedReceptor, opacity: 0.55 }, { model: 1 });
        } else if (activeStyle === "sticks") {
          xrayReceptor.setStyle({}, { stick: { color: colors.xrayReceptor, radius: 0.045 } });
          predictedReceptor.setStyle({}, { stick: { color: colors.predictedReceptor, radius: 0.045 } });
          xrayPeptide.setStyle({}, { stick: { color: colors.xrayPeptide, radius: 0.25 } });
          predictedPeptide.setStyle({}, { stick: { color: colors.predictedPeptide, radius: 0.25 } });
        } else {
          xrayReceptor.setStyle({}, { cartoon: { color: colors.xrayReceptor, opacity: 1 } });
          predictedReceptor.setStyle({}, { cartoon: { color: colors.predictedReceptor, opacity: 0.9 } });
          xrayPeptide.setStyle({}, { cartoon: { color: colors.xrayPeptide } });
          predictedPeptide.setStyle({}, { cartoon: { color: colors.predictedPeptide } });
        }

        viewer.render();
      };

      const renderCase = async (id) => {
        const item = cases[id];
        if (!item || !viewerNode) return;
        activeCase = id;
        updateCopy(id);
        setStatus("Loading structures...");

        try {
          const threeDmol = await load3Dmol();
          if (!viewer) {
            viewer = threeDmol.createViewer(viewerNode, { backgroundColor: viewerBackground });
          }

          const [xrayReceptor, xrayPeptide, predictedReceptor, predictedPeptide] = await Promise.all([
            loadPdb(`${item.base}xray-receptor.pdb`),
            loadPdb(`${item.base}xray-peptide.pdb`),
            loadPdb(`${item.base}predicted-receptor.pdb`),
            loadPdb(`${item.base}predicted-peptide.pdb`),
          ]);

          viewer.clear();
          models = [
            viewer.addModel(xrayReceptor, "pdb"),
            viewer.addModel(predictedReceptor, "pdb"),
            viewer.addModel(xrayPeptide, "pdb"),
            viewer.addModel(predictedPeptide, "pdb"),
          ];
          styleModels();
          viewer.zoomTo();
          viewer.render();
          setStatus("");
        } catch (error) {
          setStatus("Structure viewer could not load.");
          console.error(error);
        }
      };

      caseButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const id = button.dataset.structureCase;
          if (id && id !== activeCase) renderCase(id);
        });
      });

      styleButtons.forEach((button) => {
        button.addEventListener("click", () => {
          activeStyle = button.dataset.structureStyle || "cartoon";
          styleButtons.forEach((item) => item.classList.toggle("active", item === button));
          styleModels();
        });
      });

      actionButtons.forEach((button) => {
        button.addEventListener("click", () => {
          if (!viewer) return;
          if (button.dataset.structureAction === "focus") {
            viewer.zoomTo({ model: [2, 3] });
          } else {
            viewer.zoomTo();
          }
          viewer.render();
        });
      });

      renderCase(activeCase);
    }
  })();

  (() => {
    const root = document.querySelector("[data-chess-demo]");
    if (!root) return;

    const files = ["a", "b", "c", "d", "e", "f", "g", "h"];

          const cell = document.createElement("button");
          const dot = document.createElement("span");

          cell.type = "button";
          cell.className = (rankIndex + fileIndex) % 2 === 0 ? "light" : "dark";
          cell.dataset.square = square;

          dot.className = "legal-dot";

          cell.appendChild(dot);
          cell.addEventListener("click", () => handleSquareClick(square));
          boardNode.appendChild(cell);
          boardCells.set(square, { cell, pieceNode: null, piece: null, dot });
        });
      });
    };

    const renderBoard = () => {
      if (!boardNode) return;
      createBoardCells();

      boardCells.forEach((entry, square) => {
        const { cell } = entry;
        const piece = board[square];
        const isLegalTarget = legalTargets.has(square);
        const isCapture = isLegalTarget && Boolean(piece) && isBlackPiece(piece);
        const isOpenMove = isLegalTarget && !piece;

        cell.setAttribute("aria-label", piece ? `${pieceNames[piece]} on ${square}` : `Empty ${square}`);
        cell.classList.toggle("selected", square === selectedSquare);

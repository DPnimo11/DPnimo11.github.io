---
// src/components/HelixBackground.astro
---
<div id="helix-container" aria-hidden="true"></div>

<script>
  import * as THREE from 'three';

  const container = document.getElementById('helix-container');
  if (container) {
    const scene = new THREE.Scene();
    
    const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 1000);
    camera.position.z = 40;
    
    const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    container.appendChild(renderer.domElement);

    const tiltGroup = new THREE.Group();
    const helixGroup = new THREE.Group();
    tiltGroup.add(helixGroup);
    
    const numPoints = 800;
    const height = 60;
    const radius = 7.5; 
    const frequency = 0.3; 

    // Generate Points for Curves
    const points1 = [];
    const points2 = [];
    for (let i = 0; i < numPoints; i++) {
      const t = i / numPoints;
      const y = (t - 0.5) * height;
      
      const angle1 = t * height * frequency;
      const x1 = Math.cos(angle1) * radius;
      const z1 = Math.sin(angle1) * radius;
      points1.push(new THREE.Vector3(x1, y, z1));

      const angle2 = t * height * frequency + Math.PI; 
      const x2 = Math.cos(angle2) * radius;
      const z2 = Math.sin(angle2) * radius;
      points2.push(new THREE.Vector3(x2, y, z2));
    }
    const curve1 = new THREE.CatmullRomCurve3(points1);
    const curve2 = new THREE.CatmullRomCurve3(points2);

    // --- Strand 1: Wireframe Tube (Biology) ---
    const geometry1 = new THREE.TubeGeometry(curve1, 150, 0.75, 8, false);
    const wireframeGeo = new THREE.WireframeGeometry(geometry1);
    const lineMat = new THREE.LineBasicMaterial({ color: 0x111613, transparent: true, opacity: 0.35, linewidth: 1 });
    const wireframeTube = new THREE.LineSegments(wireframeGeo, lineMat);
    helixGroup.add(wireframeTube);

    // --- Strand 2: Code Tube (CS) ---
    const createDenseCodeTexture = () => {
      const canvas = document.createElement('canvas');
      canvas.width = 1024;
      canvas.height = 1024; 
      const ctx = canvas.getContext('2d');
      if (ctx) {
        ctx.fillStyle = 'rgba(255, 255, 255, 0)'; 
        ctx.fillRect(0, 0, 1024, 1024);
        ctx.fillStyle = '#111613';
        ctx.font = 'bold 24px monospace'; 
        ctx.textAlign = 'left';
        ctx.textBaseline = 'top';
        
        const snippets = [
            "struct pcb_t {", "pid_t pid;", "int status;", "void *stack;", 
            "struct pcb_t *next;", "};", "void schedule() {", "pcb_t *p = pop();", 
            "context_switch(p);", "}", "import torch", "import torch.nn as nn", 
            "class Model(nn.Module):", "def forward(self, x):", "return self.fc(x)"
        ];
        
        // Pack text incredibly tightly vertically and horizontally
        for (let y = 0; y < 1024; y += 22) {
            let lineStr = "";
            for(let i=0; i<20; i++) {
                lineStr += snippets[Math.floor(Math.random() * snippets.length)] + " ";
            }
            const offsetX = -(Math.random() * 100);
            ctx.fillText(lineStr, offsetX, y);
        }
      }
      const texture = new THREE.CanvasTexture(canvas);
      texture.wrapS = THREE.RepeatWrapping;
      texture.wrapT = THREE.RepeatWrapping;
      // Perfect aspect ratio mapping for lengthwise tube flow
      texture.repeat.set(16, 0.5); 
      texture.minFilter = THREE.LinearFilter;
      return texture;
    };

    const geometry2 = new THREE.TubeGeometry(curve2, 150, 0.75, 10, false);
    const codeTexture = createDenseCodeTexture();
    const material2 = new THREE.MeshBasicMaterial({ 
        map: codeTexture, 
        transparent: true, 
        opacity: 0.85,
        side: THREE.DoubleSide
    });
    const codeTube = new THREE.Mesh(geometry2, material2);
    helixGroup.add(codeTube);

    // --- Connecting Rungs (Half Bio, Half Code) ---
    // Clone the texture so we can map it to the short rungs independently
    const rungCodeTexture = codeTexture.clone();
    rungCodeTexture.needsUpdate = true;
    
    // Rung length is ~7.5, circumference is ~2.2.
    // To match the exact physical text size of the main tube:
    // U = 7.5 / (150/16) = 0.8
    // V = 2.2 / (4.7/0.5) = 0.234
    rungCodeTexture.repeat.set(0.8, 0.23); 
    const rungCodeMat = new THREE.MeshBasicMaterial({ map: rungCodeTexture, transparent: true, opacity: 0.85 });

    for (let i = 0; i < numPoints; i += 20) {
      const t = i / numPoints;
      
      // Calculate exact positions on the curves to guarantee perfect alignment
      const p1 = curve1.getPoint(t); 
      const p2 = curve2.getPoint(t);
      
      const distance = p1.distanceTo(p2);
      const midPoint = p1.clone().lerp(p2, 0.5);
      
      // Bio Half (Wireframe Cylinder)
      const bioGeo = new THREE.CylinderGeometry(0.35, 0.35, distance / 2, 6);
      const bioWireframeGeo = new THREE.WireframeGeometry(bioGeo);
      const bioMesh = new THREE.LineSegments(bioWireframeGeo, lineMat); // Reuse wireframe material
      
      bioMesh.position.copy(p1.clone().lerp(midPoint, 0.5));
      bioMesh.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), midPoint.clone().sub(p1).normalize());
      helixGroup.add(bioMesh);

      // Code Half (Static Code Tube)
      // TubeGeometry guarantees text flows flawlessly lengthwise
      const rungCurve = new THREE.LineCurve3(midPoint, p2);
      const codeGeo = new THREE.TubeGeometry(rungCurve, 2, 0.35, 8, false);
      const codeMesh = new THREE.Mesh(codeGeo, rungCodeMat);
      helixGroup.add(codeMesh);
    }

    // Position and tilt the parent group
    tiltGroup.rotation.z = -Math.PI / 4; 
    tiltGroup.position.x = -12; 
    tiltGroup.position.y = -5;
    
    scene.add(tiltGroup);

    // Animation Loop
    const animate = function () {
      requestAnimationFrame(animate);
      helixGroup.rotation.y += 0.0025; // Pure rotation around the internal Y axis
      
      // Scroll main tube lengthwise
      codeTexture.offset.x -= 0.005;
      
      // We intentionally do NOT scroll rungCodeTexture here, 
      // so it remains physically locked to the rotating helix structure.
      
      renderer.render(scene, camera);
    };

    animate();

    // Handle Window Resize
    window.addEventListener('resize', () => {
      const parent = container.parentElement;
      if (parent) {
        camera.aspect = parent.clientWidth / parent.clientHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(parent.clientWidth, parent.clientHeight);
      }
    });
    
    // Initial size
    const parent = container.parentElement;
    if (parent) {
      camera.aspect = parent.clientWidth / parent.clientHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(parent.clientWidth, parent.clientHeight);
    }
  }
</script>

<style>
  #helix-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }
</style>
